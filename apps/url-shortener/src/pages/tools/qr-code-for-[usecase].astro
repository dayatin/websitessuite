---
import { getAntiFOUCScript, renderHeaderHTML, renderFooterHTML } from "@suite/ui-theme";
import { renderMetaTags, buildWebApplicationSchema, buildBreadcrumbSchema } from "@suite/seo-core";
import { renderAdSlotHTML, renderConsentBannerHTML, getConsentModeScript } from "@suite/monetization";
import { QR_USECASES_DATA, type QRCodeUseCaseData } from "../../lib/programmatic-data.ts";

export function getStaticPaths() {
  return QR_USECASES_DATA.map((usecase) => ({
    params: { usecase: usecase.slug },
    props: { usecase },
  }));
}

interface Props {
  usecase: QRCodeUseCaseData;
}

const { usecase } = Astro.props;
const siteTitle = `${usecase.title} | OmniLink`;
const canonicalUrl = Astro.site ? new URL(`tools/qr-code-for-${usecase.slug}`, Astro.site).href : `https://url-shortener.suite.local/tools/qr-code-for-${usecase.slug}`;

const metaHtml = renderMetaTags({
  title: siteTitle,
  description: usecase.description,
  canonicalUrl,
  siteName: "OmniLink",
});

const schemaApp = buildWebApplicationSchema({
  name: usecase.title,
  url: canonicalUrl,
  description: usecase.description,
  applicationCategory: "DesignApplication",
});

const schemaBreadcrumbs = buildBreadcrumbSchema([
  { name: "Home", url: "https://url-shortener.suite.local/" },
  { name: "QR Tools", url: "https://url-shortener.suite.local/tools" },
  { name: usecase.name, url: canonicalUrl },
]);

const adSlot = renderAdSlotHTML({
  client: "ca-pub-0000000000000000",
  slotId: "1002003005",
  format: "leaderboard",
  testMode: true,
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline set:html={getAntiFOUCScript()} />
    <Fragment set:html={getConsentModeScript()} />
    <Fragment set:html={metaHtml} />
    <script type="application/ld+json" is:inline set:html={schemaApp} />
    <script type="application/ld+json" is:inline set:html={schemaBreadcrumbs} />
    <link rel="stylesheet" href="/node_modules/@suite/ui-theme/src/styles/base.css" />
  </head>
  <body>
    <Fragment set:html={renderHeaderHTML({ siteTitle: "OmniLink", navItems: [{ label: "Shortener", href: "/" }, { label: "Unshorten", href: "/unshorten" }, { label: "Tools", href: "/" }] })} />

    <main class="suite-container" style="flex: 1; padding-block: 2.5rem; max-width: 840px;">
      <section style="text-align: center; margin-bottom: 2rem;">
        <div style="font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; color: var(--accent-primary); margin-bottom: 6px;">
          Vector QR Studio Preset
        </div>
        <h1 style="font-size: 2.5rem; font-weight: 800; margin-bottom: 0.75rem;">{usecase.title}</h1>
        <p style="font-size: 1.125rem; color: var(--text-secondary); max-width: 680px; margin-inline: auto;">
          {usecase.description}
        </p>
      </section>

      <Fragment set:html={adSlot} />

      <!-- Specs & Sizing Matrix -->
      <div class="suite-card" style="padding: 2rem; margin-bottom: 2rem;">
        <h2 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 1rem;">Recommended Print Specifications</h2>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 1.5rem;">
          <div style="padding: 1rem; border-radius: 8px; background: var(--bg-surface-elevated); border: 1px solid var(--border-subtle);">
            <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;">Standard Print Size</div>
            <div style="font-size: 1.125rem; font-weight: 700; color: var(--accent-primary);">{usecase.recommendedSize}</div>
          </div>
          <div style="padding: 1rem; border-radius: 8px; background: var(--bg-surface-elevated); border: 1px solid var(--border-subtle);">
            <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;">Error Correction Level</div>
            <div style="font-size: 1.125rem; font-weight: 700; color: var(--accent-primary);">Tier {usecase.errorCorrection} (Max Durability)</div>
          </div>
        </div>

        <a href="/" class="suite-btn-primary" style="display: inline-flex; text-decoration: none;">
          Open QR Designer & Export SVG &rarr;
        </a>
      </div>

      <!-- Guidelines -->
      <section class="suite-card" style="padding: 2rem; line-height: 1.7;">
        <h2 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 1rem;">Printing & Placement Guidelines</h2>
        <ul style="padding-left: 1.25rem; color: var(--text-secondary);">
          {usecase.guidelines.map((guide) => (
            <li style="margin-bottom: 8px;">{guide}</li>
          ))}
        </ul>
      </section>
    </main>

    <Fragment set:html={renderFooterHTML({ siteTitle: "OmniLink", tagline: "Professional vector QR codes." })} />
    <Fragment set:html={renderConsentBannerHTML()} />
  </body>
</html>
