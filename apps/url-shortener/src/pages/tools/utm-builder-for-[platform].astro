---
import { getAntiFOUCScript, renderHeaderHTML, renderFooterHTML } from "@suite/ui-theme";
import { renderMetaTags, buildWebApplicationSchema, buildBreadcrumbSchema } from "@suite/seo-core";
import { renderAdSlotHTML, renderConsentBannerHTML, getConsentModeScript } from "@suite/monetization";
import { PLATFORMS_DATA, type PlatformSEOData } from "../../lib/programmatic-data.ts";

export function getStaticPaths() {
  return PLATFORMS_DATA.map((platform) => ({
    params: { platform: platform.slug },
    props: { platform },
  }));
}

interface Props {
  platform: PlatformSEOData;
}

const { platform } = Astro.props;
const siteTitle = `${platform.title} | OmniLink`;
const canonicalUrl = Astro.site ? new URL(`tools/utm-builder-for-${platform.slug}`, Astro.site).href : `https://url-shortener.suite.local/tools/utm-builder-for-${platform.slug}`;

const metaHtml = renderMetaTags({
  title: siteTitle,
  description: platform.description,
  canonicalUrl,
  siteName: "OmniLink",
});

const schemaApp = buildWebApplicationSchema({
  name: platform.title,
  url: canonicalUrl,
  description: platform.description,
  applicationCategory: "BusinessApplication",
});

const schemaBreadcrumbs = buildBreadcrumbSchema([
  { name: "Home", url: "https://url-shortener.suite.local/" },
  { name: "Tools", url: "https://url-shortener.suite.local/tools" },
  { name: platform.name, url: canonicalUrl },
]);

const adSlot = renderAdSlotHTML({
  client: "ca-pub-0000000000000000",
  slotId: "1002003004",
  format: "leaderboard",
  testMode: true,
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline set:html={getAntiFOUCScript()} />
    <Fragment set:html={getConsentModeScript()} />
    <Fragment set:html={metaHtml} />
    <script type="application/ld+json" is:inline set:html={schemaApp} />
    <script type="application/ld+json" is:inline set:html={schemaBreadcrumbs} />
    <link rel="stylesheet" href="/node_modules/@suite/ui-theme/src/styles/base.css" />
  </head>
  <body>
    <Fragment set:html={renderHeaderHTML({ siteTitle: "OmniLink", navItems: [{ label: "Shortener", href: "/" }, { label: "Unshorten", href: "/unshorten" }, { label: "Tools", href: "/" }] })} />

    <main class="suite-container" style="flex: 1; padding-block: 2.5rem; max-width: 840px;">
      <section style="text-align: center; margin-bottom: 2rem;">
        <div style="font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; color: var(--accent-primary); margin-bottom: 6px;">
          Campaign Tracking & Optimization
        </div>
        <h1 style="font-size: 2.5rem; font-weight: 800; margin-bottom: 0.75rem;">{platform.title}</h1>
        <p style="font-size: 1.125rem; color: var(--text-secondary); max-width: 680px; margin-inline: auto;">
          {platform.description}
        </p>
      </section>

      <Fragment set:html={adSlot} />

      <!-- Interactive Generator Pre-loaded for Platform -->
      <div class="suite-card" style="padding: 2rem; margin-bottom: 2.5rem;">
        <h2 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 1rem;">Generate Your Tracked {platform.name} Link</h2>
        <div style="display: flex; flex-direction: column; gap: 12px;">
          <div>
            <label style="font-size: 0.8125rem; color: var(--text-muted); display: block; margin-bottom: 4px;">Target Landing Page URL *</label>
            <input type="url" id="p-url" placeholder="https://yourbrand.com/landing-page" style="width: 100%; min-height: 42px; padding: 8px 12px; border-radius: 6px; border: 1px solid var(--border-subtle); background: var(--bg-surface-elevated); color: var(--text-primary);" />
          </div>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
            <div>
              <label style="font-size: 0.8125rem; color: var(--text-muted); display: block; margin-bottom: 4px;">utm_source</label>
              <input type="text" id="p-source" value={platform.slug} readonly style="width: 100%; min-height: 40px; padding: 6px 12px; border-radius: 6px; border: 1px solid var(--border-subtle); background: var(--bg-base); color: var(--text-muted);" />
            </div>
            <div>
              <label style="font-size: 0.8125rem; color: var(--text-muted); display: block; margin-bottom: 4px;">utm_medium</label>
              <input type="text" id="p-medium" value={platform.defaultMedium} style="width: 100%; min-height: 40px; padding: 6px 12px; border-radius: 6px; border: 1px solid var(--border-subtle); background: var(--bg-surface-elevated); color: var(--text-primary);" />
            </div>
          </div>
          <div>
            <label style="font-size: 0.8125rem; color: var(--text-muted); display: block; margin-bottom: 4px;">utm_campaign</label>
            <input type="text" id="p-campaign" value={platform.defaultCampaign} style="width: 100%; min-height: 40px; padding: 6px 12px; border-radius: 6px; border: 1px solid var(--border-subtle); background: var(--bg-surface-elevated); color: var(--text-primary);" />
          </div>
          <a href="/" class="suite-btn-primary" style="margin-top: 8px; text-align: center; text-decoration: none;">Shorten in OmniLink Studio &rarr;</a>
        </div>
      </div>

      <!-- Platform-Specific Best Practices & SEO Content -->
      <section class="suite-card" style="padding: 2rem; line-height: 1.7;">
        <h2 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 1rem;">Best Practices for {platform.name} Link Tracking</h2>
        <ul style="padding-left: 1.25rem; color: var(--text-secondary); margin-bottom: 1.5rem;">
          {platform.bestPractices.map((tip) => (
            <li style="margin-bottom: 8px;">{tip}</li>
          ))}
        </ul>
      </section>
    </main>

    <Fragment set:html={renderFooterHTML({ siteTitle: "OmniLink", tagline: "Data-driven campaign tools." })} />
    <Fragment set:html={renderConsentBannerHTML()} />
  </body>
</html>
