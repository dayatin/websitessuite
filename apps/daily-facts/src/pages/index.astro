---
import "@suite/ui-theme/base.css";
import { getAntiFOUCScript, renderHeaderHTML, renderFooterHTML } from "@suite/ui-theme";
import { renderMetaTags, buildWebApplicationSchema, buildFAQSchema } from "@suite/seo-core";
import { renderAdSlotHTML, renderAffiliateCardHTML, renderConsentBannerHTML, getConsentModeScript } from "@suite/monetization";
import { FactCorpusLoader } from "../lib/corpus/loader.ts";
import { CATEGORIES } from "../lib/corpus/seed-data.ts";

const loader = new FactCorpusLoader();
const today = new Date();
const todayFact = loader.getFactOfTheDay(today);
const dailyQuiz = loader.getDailyQuiz(today, 5);

const siteTitle = "FactSphere | Massive Verified Daily Fact Database & Fact or Myth Quiz";
const canonicalUrl = Astro.site ? Astro.site.toString() : "https://daily-facts.suite.local/";
const description = "Discover thousands of citation-backed facts across Science, Space, Nature, History, and Biology. Play the daily 'Fact or Myth' streak quiz and download high-res social fact cards.";

const metaHtml = renderMetaTags({
  title: siteTitle,
  description,
  canonicalUrl,
  siteName: "FactSphere",
});

const schemaApp = buildWebApplicationSchema({
  name: "FactSphere Daily Facts Platform",
  url: canonicalUrl,
  description,
  applicationCategory: "EducationalApplication",
});

const faqItems = [
  {
    question: "How are facts on FactSphere verified?",
    answer: "Every fact in our database undergoes primary-source editorial cross-examination against peer-reviewed journals, academic repositories, and national institutions (such as NASA, Smithsonian, and Nature). Unverified claims or popular folklore are categorized explicitly under our 'Debunked Myths' collection."
  },
  {
    question: "How does the 'Fact or Myth?' Daily Streak game work?",
    answer: "Every day at 00:00 UTC, a fresh 5-question trivia set is unlocked. Players decide whether each statement is an authentic fact or a debunked misconception. At the end, you receive an in-depth scientific explanation and a Wordle-style spoiler-free share grid."
  },
  {
    question: "Can I download and share social fact cards?",
    answer: "Yes! Our built-in Social Card Studio renders 1080x1080 high-resolution graphics ready for Instagram, LinkedIn, or Pinterest with 1 click."
  }
];

const schemaFaq = buildFAQSchema(faqItems);

const adLeaderboard = renderAdSlotHTML({
  client: "ca-pub-0000000000000000",
  slotId: "2001001000",
  format: "leaderboard",
  testMode: true,
});

const affiliateCard = renderAffiliateCardHTML({
  title: "Listen to Great Science & History",
  description: "Get 2 free audiobooks from Audible with our exclusive knowledge partner invite. Stream acclaimed works on human history, quantum physics, and nature.",
  ctaText: "Claim Free Audiobooks",
  affiliateUrl: "https://partner.suite.local/audible",
  merchantName: "Audible",
  badge: "Recommended",
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline set:html={getAntiFOUCScript()} />
    <Fragment set:html={getConsentModeScript()} />
    <Fragment set:html={metaHtml} />
    <script type="application/ld+json" is:inline set:html={schemaApp} />
    <script type="application/ld+json" is:inline set:html={schemaFaq} />
    <style>
      .tab-btn {
        padding: 10px 18px;
        font-weight: 600;
        border-radius: 8px;
        background: transparent;
        border: 1px solid transparent;
        color: var(--text-secondary);
        cursor: pointer;
        transition: all 0.2s ease;
      }
      .tab-btn.active {
        background: var(--bg-surface-elevated);
        border-color: var(--border-strong);
        color: var(--text-primary);
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
      }
      .tab-pane {
        display: none;
      }
      .tab-pane.active {
        display: block;
      }
    </style>
  </head>
  <body>
    <Fragment set:html={renderHeaderHTML({ siteTitle: "FactSphere", navItems: [{ label: "Today's Fact", href: "/today" }, { label: "Categories", href: "/" }, { label: "RSS Feed", href: "/feed.xml", external: true }] })} />

    <main class="suite-container" style="flex: 1; padding-block: 2.5rem;">
      <section style="text-align: center; margin-bottom: 2rem;">
        <h1 style="font-size: 2.75rem; font-weight: 800; margin-bottom: 0.75rem; letter-spacing: -0.02em;">
          Massive Verified Fact Database
        </h1>
        <p style="font-size: 1.125rem; color: var(--text-secondary); max-width: 680px; margin-inline: auto;">
          Peer-reviewed facts, daily rotation, "Fact or Myth" trivia streak, and 1-click social graphics.
        </p>
      </section>

      <!-- Zero-CLS Leaderboard Ad Unit -->
      <Fragment set:html={adLeaderboard} />

      <!-- Interactive Studio Container -->
      <div class="suite-card" style="max-width: 820px; margin-inline: auto; padding: 2rem; margin-bottom: 2.5rem;">
        <!-- Tab Navigation -->
        <div style="display: flex; gap: 8px; margin-bottom: 1.75rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 12px; flex-wrap: wrap;">
          <button type="button" class="tab-btn active" data-tab="tab-explorer">⚡ Fact Explorer (J/K)</button>
          <button type="button" class="tab-btn" data-tab="tab-quiz">🎯 "Fact or Myth?" Daily Quiz</button>
          <button type="button" class="tab-btn" data-tab="tab-card">🖼️ 1-Click Social Card Studio</button>
        </div>

        <!-- TAB 1: Keyboard Fact Explorer -->
        <div id="tab-explorer" class="tab-pane active">
          <!-- Category Pills -->
          <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 1.5rem;">
            <button type="button" class="suite-btn-secondary cat-filter-btn active" data-category="all" style="font-size: 0.8125rem; min-height: 34px; padding: 4px 12px;">🌟 All Facts</button>
            {CATEGORIES.map((cat) => (
              <button type="button" class="suite-btn-secondary cat-filter-btn" data-category={cat.slug} style="font-size: 0.8125rem; min-height: 34px; padding: 4px 12px;">
                {cat.icon} {cat.label}
              </button>
            ))}
          </div>

          <!-- Active Fact Display -->
          <div id="fact-card-box" style="padding: 2rem; border-radius: 12px; background: var(--bg-base); border: 1px solid var(--border-subtle); margin-bottom: 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
              <span id="fact-cat-badge" style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--accent-primary);">
                {todayFact.category.toUpperCase()} {todayFact.subtopic ? `• ${todayFact.subtopic}` : ""}
              </span>
              <span id="fact-read-time" style="font-size: 0.75rem; color: var(--text-muted);">
                ⏱️ {todayFact.reading_time_seconds}s read
              </span>
            </div>

            <h2 id="fact-headline" style="font-size: 1.75rem; font-weight: 800; line-height: 1.4; margin-bottom: 1rem; color: var(--text-primary);">
              "{todayFact.fact_text}"
            </h2>

            <p id="fact-details" style="font-size: 1.0625rem; color: var(--text-secondary); line-height: 1.7; margin-bottom: 1.5rem;">
              {todayFact.explanation}
            </p>

            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; border-top: 1px solid var(--border-subtle); padding-top: 1rem;">
              <div style="font-size: 0.875rem; color: var(--text-muted);">
                Source: <strong id="fact-source-name">{todayFact.source_name}</strong>
              </div>
              <a id="fact-source-link" href={todayFact.source_url} target="_blank" rel="noopener noreferrer" style="color: var(--accent-primary); font-size: 0.875rem; text-decoration: underline;">
                Verify Primary Source &rarr;
              </a>
            </div>
          </div>

          <!-- Controls & Keyboard Hint -->
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
            <span style="font-size: 0.8125rem; color: var(--text-muted);">
              Keyboard Shortcuts: Press <kbd style="padding: 2px 6px; background: var(--bg-surface-elevated); border: 1px solid var(--border-subtle); border-radius: 4px;">Space</kbd> or <kbd style="padding: 2px 6px; background: var(--bg-surface-elevated); border: 1px solid var(--border-subtle); border-radius: 4px;">J / K</kbd> for next fact.
            </span>
            <button type="button" id="next-fact-btn" class="suite-btn-primary" style="padding: 8px 20px;">
              Next Fact &rarr;
            </button>
          </div>
        </div>

        <!-- TAB 2: "Fact or Myth?" Daily Quiz -->
        <div id="tab-quiz" class="tab-pane">
          <div style="text-align: center; margin-bottom: 1.5rem;">
            <h2 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 4px;">Daily "Fact or Myth?" Challenge</h2>
            <p style="font-size: 0.875rem; color: var(--text-secondary);">
              5 daily questions. Test your scientific and historical knowledge. Can you spot the myth?
            </p>
          </div>

          <div id="quiz-question-box" style="padding: 2rem; background: var(--bg-base); border: 1px solid var(--border-subtle); border-radius: 12px; margin-bottom: 1.5rem; text-align: center;">
            <div id="quiz-progress" style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); margin-bottom: 8px;">Question 1 of 5</div>
            <div id="quiz-statement" style="font-size: 1.375rem; font-weight: 700; line-height: 1.4; margin-bottom: 1.5rem;">
              "{dailyQuiz[0].question_text}"
            </div>

            <div style="display: flex; gap: 16px; justify-content: center; margin-bottom: 1rem;">
              <button type="button" class="suite-btn-primary quiz-answer-btn" data-answer="fact" style="padding: 12px 32px; font-size: 1rem; background: #10b981;">
                ✅ Authentic Fact
              </button>
              <button type="button" class="suite-btn-primary quiz-answer-btn" data-answer="myth" style="padding: 12px 32px; font-size: 1rem; background: #ef4444;">
                ❌ Debunked Myth
              </button>
            </div>

            <div id="quiz-explanation" style="display: none; padding: 1rem; background: var(--bg-surface-elevated); border-radius: 8px; margin-top: 1rem; text-align: left; font-size: 0.9375rem; line-height: 1.6;"></div>
          </div>
        </div>

        <!-- TAB 3: 1-Click Social Card Studio -->
        <div id="tab-card" class="tab-pane">
          <div style="text-align: center; margin-bottom: 1.5rem;">
            <h2 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 4px;">1-Click Social Fact Card Studio</h2>
            <p style="font-size: 0.875rem; color: var(--text-secondary);">
              Export square 1080x1080 graphic cards ready for Instagram, LinkedIn, and social feeds.
            </p>
          </div>

          <div style="display: flex; justify-content: center; margin-bottom: 1.5rem;">
            <div id="social-card-preview" style="width: 100%; max-width: 480px; aspect-ratio: 1/1; background: #0a0c10; border-radius: 16px; padding: 2rem; display: flex; flex-direction: column; justify-content: space-between; text-align: center; border: 2px solid #27272a; box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
              <div>
                <span style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent-primary); border: 1px solid var(--accent-primary); padding: 4px 12px; border-radius: 9999px;">
                  {todayFact.category.toUpperCase()}
                </span>
              </div>
              <div style="font-size: 1.375rem; font-weight: 800; color: #ffffff; line-height: 1.4;">
                "{todayFact.fact_text}"
              </div>
              <div>
                <div style="font-size: 0.8125rem; color: #a1a1aa; margin-bottom: 4px;">Verified by {todayFact.source_name}</div>
                <div style="font-size: 0.9375rem; font-weight: 700; color: var(--accent-primary);">FactSphere.suite</div>
              </div>
            </div>
          </div>

          <div style="display: flex; justify-content: center; gap: 12px;">
            <button type="button" id="download-card-btn" class="suite-btn-primary" style="padding: 10px 24px;">
              📥 Download Card (1080x1080 PNG)
            </button>
          </div>
        </div>
      </div>

      <!-- Affiliate Partner Promotion -->
      <Fragment set:html={affiliateCard} />

      <!-- Deep Editorial SEO Context -->
      <section class="suite-card" style="max-width: 820px; margin-inline: auto; margin-block: 2.5rem; line-height: 1.7;">
        <h2 style="font-size: 1.625rem; font-weight: 700; margin-bottom: 1rem;">Why Scientific Fact-Checking and Attribution Matter</h2>
        <p style="color: var(--text-secondary); margin-bottom: 1.25rem;">
          In an era saturated with sensationalized headlines and AI-generated misinformation, maintaining rigorous factual standards is essential. Many common beliefs—such as the myth that humans only use 10% of their brains or that the Great Wall of China is visible from orbit with the naked eye—originated decades before modern instrumentation existed.
        </p>
        <p style="color: var(--text-secondary); margin-bottom: 1.5rem;">
          At FactSphere, our editorial team checks claims against peer-reviewed journals, national space agencies, and established historical archives. By providing complete explanations and direct links to primary literature, we empower curious minds to verify truth for themselves.
        </p>

        <h3 style="font-size: 1.25rem; font-weight: 600; margin-top: 1.5rem; margin-bottom: 0.75rem;">Frequently Asked Questions</h3>
        <div style="display: flex; flex-direction: column; gap: 14px;">
          {faqItems.map((faq) => (
            <div style="border-top: 1px solid var(--border-subtle); padding-top: 10px;">
              <h4 style="font-size: 1rem; font-weight: 600; margin-bottom: 4px;">{faq.question}</h4>
              <p style="font-size: 0.9375rem; color: var(--text-secondary);">{faq.answer}</p>
            </div>
          ))}
        </div>
      </section>
    </main>

    <Fragment set:html={renderFooterHTML({ siteTitle: "FactSphere", tagline: "Verified knowledge refreshed every 24 hours." })} />
    <Fragment set:html={renderConsentBannerHTML()} />

    <script is:inline>
      // Tab switcher
      const tabs = document.querySelectorAll(".tab-btn");
      const panes = document.querySelectorAll(".tab-pane");
      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          tabs.forEach((t) => t.classList.remove("active"));
          panes.forEach((p) => p.classList.remove("active"));
          tab.classList.add("active");
          const target = tab.getAttribute("data-tab");
          if (target) document.getElementById(target)?.classList.add("active");
        });
      });

      // Keyboard navigation for facts
      window.addEventListener("keydown", (e) => {
        if (e.target.tagName === "INPUT" || e.target.tagName === "TEXTAREA") return;
        if (e.code === "Space" || e.key === "j" || e.key === "J" || e.key === "ArrowRight") {
          e.preventDefault();
          document.getElementById("next-fact-btn")?.click();
        }
      });
    </script>
  </body>
</html>
