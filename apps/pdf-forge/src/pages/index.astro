---
import "@suite/ui-theme/base.css";
import { getAntiFOUCScript, renderHeaderHTML, renderFooterHTML } from "@suite/ui-theme";
import { renderMetaTags, buildFAQSchema, buildBreadcrumbSchema, buildWebApplicationSchema } from "@suite/seo-core";
import { renderAdSlotHTML, renderAffiliateCardHTML, renderConsentBannerHTML, getConsentModeScript } from "@suite/monetization";
import { PDF_TOOLS } from "../lib/pdf-engine.ts";

const siteTitle = "PDFForge Local | 100% Client-Side Private PDF Tools";
const canonicalUrl = Astro.site ? Astro.site.href : "https://pdf-forge.suite.local/";
const description = "Merge, split, rotate, organize, and edit PDF metadata directly in your web browser. Zero server uploads, zero data retention, and 100% private processing.";

const metaHtml = renderMetaTags({
  title: siteTitle,
  description,
  canonicalUrl,
  siteName: "PDFForge Local",
  type: "website",
});

const appSchema = buildWebApplicationSchema({
  name: "PDFForge Local",
  url: canonicalUrl,
  description,
  applicationCategory: "UtilitiesApplication",
});

const faqs = [
  {
    question: "Do my PDF files ever get uploaded to an external server or cloud?",
    answer: "No. Never. PDFForge Local utilizes client-side WebAssembly and JavaScript to execute 100% of PDF processing within your browser memory. Your files never touch a remote server.",
  },
  {
    question: "Is there any limit on file size or the number of documents I can merge?",
    answer: "Because processing runs entirely on your local machine hardware, there are no artificial subscription paywalls or arbitrary file size limits.",
  },
  {
    question: "Is PDFForge Local completely free to use?",
    answer: "Yes, all tools across PDFForge Local are 100% free and engineered to adhere to strict Google Webmaster and AdSense policies with zero Cumulative Layout Shift (CLS=0.000).",
  },
];

const faqSchema = buildFAQSchema(faqs);
const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Home", url: canonicalUrl },
]);

const adSlotTop = renderAdSlotHTML({
  client: "ca-pub-0000000000000000",
  slotId: "7001001001",
  format: "leaderboard",
  testMode: true,
});

const adSlotBottom = renderAdSlotHTML({
  client: "ca-pub-0000000000000000",
  slotId: "7001001002",
  format: "rectangle",
  testMode: true,
});

const affiliateOffer = renderAffiliateCardHTML({
  title: "Adobe Acrobat Pro — Enterprise Document Solutions",
  description: "Advanced OCR scan conversion, legal e-signatures, and team document collaboration across desktop and mobile devices.",
  ctaText: "Explore Adobe Acrobat",
  affiliateUrl: "https://partner.suite.local/adobe-acrobat",
  merchantName: "Adobe Partner Network",
  badge: "Recommended Suite",
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Fragment set:html={metaHtml} />
    <Fragment set:html={getAntiFOUCScript()} />
    <Fragment set:html={getConsentModeScript()} />
    <Fragment set:html={appSchema} />
    <Fragment set:html={faqSchema} />
    <Fragment set:html={breadcrumbSchema} />
    <style>
      .hero-section {
        text-align: center;
        padding: 3rem 1rem 2rem;
        max-width: 900px;
        margin: 0 auto;
      }
      .privacy-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(16, 185, 129, 0.12);
        color: #059669;
        font-weight: 700;
        font-size: 0.85rem;
        padding: 0.35rem 0.85rem;
        border-radius: 9999px;
        margin-bottom: 1rem;
        border: 1px solid rgba(16, 185, 129, 0.25);
      }
      .hero-title {
        font-size: 2.75rem;
        font-weight: 900;
        letter-spacing: -0.03em;
        line-height: 1.15;
        margin-bottom: 1rem;
      }
      .hero-subtitle {
        font-size: 1.2rem;
        color: #64748b;
        max-width: 720px;
        margin: 0 auto 2rem;
        line-height: 1.6;
      }
      .studio-box {
        background: #ffffff;
        border: 2px dashed #cbd5e1;
        border-radius: 1rem;
        padding: 2.5rem 1.5rem;
        text-align: center;
        margin: 1.5rem auto 2.5rem;
        max-width: 750px;
        transition: border-color 0.2s ease;
      }
      .studio-box:hover {
        border-color: #3b82f6;
      }
      .tools-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
        max-width: 1000px;
        margin: 2.5rem auto;
      }
      .tool-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 0.85rem;
        padding: 1.75rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        text-align: left;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }
      .tool-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.06);
      }
      .tool-badge {
        align-self: flex-start;
        font-size: 0.72rem;
        font-weight: 800;
        text-transform: uppercase;
        background: #f1f5f9;
        color: #475569;
        padding: 0.2rem 0.5rem;
        border-radius: 0.35rem;
        margin-bottom: 0.75rem;
      }
      .tool-icon {
        font-size: 2.25rem;
        margin-bottom: 0.75rem;
      }
      .tool-title {
        font-size: 1.25rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
        color: #0f172a;
      }
      .tool-desc {
        font-size: 0.92rem;
        color: #64748b;
        line-height: 1.5;
        margin-bottom: 1.25rem;
      }
      .tool-btn {
        display: inline-block;
        text-align: center;
        background: #0f172a;
        color: #ffffff;
        font-weight: 700;
        font-size: 0.9rem;
        padding: 0.7rem 1.2rem;
        border-radius: 0.5rem;
        text-decoration: none;
        transition: background 0.15s ease;
      }
      .tool-btn:hover {
        background: #2563eb;
      }
      .faq-list {
        max-width: 800px;
        margin: 2.5rem auto;
        text-align: left;
      }
      .faq-item {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 0.75rem;
        padding: 1.25rem 1.5rem;
        margin-bottom: 1rem;
      }
      .faq-item h3 {
        font-size: 1.05rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        color: #0f172a;
      }
      .faq-item p {
        font-size: 0.92rem;
        color: #475569;
        line-height: 1.5;
        margin: 0;
      }
    </style>
  </head>
  <body>
    <Fragment set:html={renderHeaderHTML({ currentPath: "/" })} />

    <main class="container">
      <section class="hero-section">
        <div class="privacy-badge">
          <span>🔒</span> 100% Client-Side Local Processing — Files Never Leave Your Device
        </div>
        <h1 class="hero-title">Private In-Browser PDF Studio</h1>
        <p class="hero-subtitle">
          Merge multiple documents, split pages, correct rotation, reorder scans, and update metadata directly in your browser. Powered by client-side WebAssembly with zero server uploads.
        </p>

        <!-- Zero-CLS Monetization Slot -->
        <div style="margin: 1.5rem 0 2rem;">
          <Fragment set:html={adSlotTop} />
        </div>

        <div class="studio-box">
          <div style="font-size: 3rem; margin-bottom: 1rem;">📄</div>
          <h2 style="font-size: 1.35rem; font-weight: 800; margin-bottom: 0.5rem;">Drag and drop PDF files here</h2>
          <p style="color: #64748b; font-size: 0.95rem; margin-bottom: 1.5rem;">Or select one of our focused tools below for dedicated manipulation</p>
          <a href="/tools/merge-pdf" class="tool-btn" style="padding: 0.85rem 1.75rem; font-size: 1rem;">
            Open Merge PDF Tool →
          </a>
        </div>
      </section>

      <!-- Tools Grid -->
      <section id="tools">
        <h2 style="text-align: center; font-size: 1.75rem; font-weight: 800; margin-bottom: 0.5rem;">Dedicated PDF Tool Suites</h2>
        <p style="text-align: center; color: #64748b; margin-bottom: 2rem;">Choose the precise operation you need with zero subscription limits</p>
        
        <div class="tools-grid">
          {PDF_TOOLS.map((tool) => (
            <article class="tool-card">
              <div>
                <span class="tool-badge">{tool.badge}</span>
                <div class="tool-icon">{tool.icon}</div>
                <h3 class="tool-title">{tool.title}</h3>
                <p class="tool-desc">{tool.description}</p>
              </div>
              <a href={`/tools/${tool.slug}`} class="tool-btn">
                Launch {tool.title} →
              </a>
            </article>
          ))}
        </div>
      </section>

      <!-- Affiliate Partner Section -->
      <section style="max-width: 800px; margin: 3rem auto;">
        <Fragment set:html={affiliateOffer} />
      </section>

      <!-- FAQs -->
      <section class="faq-list">
        <h2 style="text-align: center; font-size: 1.75rem; font-weight: 800; margin-bottom: 1.5rem;">Frequently Asked Questions</h2>
        {faqs.map((faq) => (
          <div class="faq-item">
            <h3>{faq.question}</h3>
            <p>{faq.answer}</p>
          </div>
        ))}
      </section>

      <!-- Zero-CLS Monetization Slot -->
      <div style="margin: 2.5rem 0;">
        <Fragment set:html={adSlotBottom} />
      </div>
    </main>

    <Fragment set:html={renderFooterHTML()} />
    <Fragment set:html={renderConsentBannerHTML()} />
  </body>
</html>
