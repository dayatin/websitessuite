---
import "@suite/ui-theme/base.css";
import { getAntiFOUCScript, renderHeaderHTML, renderFooterHTML } from "@suite/ui-theme";
import { renderMetaTags, buildPersonSchema, buildBreadcrumbSchema } from "@suite/seo-core";
import { renderAdSlotHTML, renderAffiliateCardHTML, renderConsentBannerHTML, getConsentModeScript } from "@suite/monetization";
import { QuoteCorpusLoader } from "../../lib/corpus/loader.ts";
import { getBookRecommendationForAuthor } from "../../lib/books.ts";

export function getStaticPaths() {
  const loader = new QuoteCorpusLoader();
  const authors = loader.getAllAuthors();
  return authors.map((author) => ({
    params: { slug: author.slug },
    props: { author },
  }));
}

const { author } = Astro.props;
const loader = new QuoteCorpusLoader();
const quotes = loader.getQuotesByAuthor(author.slug);

const siteTitle = `${author.name} Quotes, Philosophy & Biography | VerbaLogos`;
const canonicalUrl = Astro.site
  ? new URL(`author/${author.slug}`, Astro.site).href
  : `https://daily-quotes.suite.local/author/${author.slug}`;
const description = `Discover profound quotes, philosophical reflections, and biography of ${author.name} (${author.profession}, ${author.born_year || ""} - ${author.died_year || ""}). Free 4K wallpapers and reading recommendations.`;

const metaHtml = renderMetaTags({
  title: siteTitle,
  description,
  canonicalUrl,
  siteName: "VerbaLogos",
  type: "article",
});

const personSchema = buildPersonSchema({
  name: author.name,
  description: author.bio,
  jobTitle: author.profession,
  birthDate: author.born_year,
  deathDate: author.died_year,
  nationality: author.nationality,
  sameAs: author.wikipedia_url,
  image: author.avatar_url,
});

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Home", url: "https://daily-quotes.suite.local/" },
  { name: "Authors", url: "https://daily-quotes.suite.local/#authors" },
  { name: author.name, url: canonicalUrl },
]);

const adSlot = renderAdSlotHTML({
  client: "ca-pub-0000000000000000",
  slotId: "3001001002",
  format: "rectangle",
  testMode: true,
});

const affiliateOffer = getBookRecommendationForAuthor(author.slug);
const affiliateCard = renderAffiliateCardHTML(affiliateOffer);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline set:html={getAntiFOUCScript()} />
    <Fragment set:html={getConsentModeScript()} />
    <Fragment set:html={metaHtml} />
    <script type="application/ld+json" is:inline set:html={personSchema} />
    <script type="application/ld+json" is:inline set:html={breadcrumbSchema} />
  </head>
  <body>
    <Fragment set:html={renderHeaderHTML({ siteTitle: "VerbaLogos", navItems: [{ label: "Today (#QOTD)", href: "/today" }, { label: "Wallpaper Studio", href: "/" }, { label: "Quotes", href: "/" }, { label: "RSS Feed", href: "/feed.xml", external: true }] })} />

    <main class="suite-container" style="flex: 1; padding-block: 2.5rem; max-width: 860px;">
      <!-- Breadcrumb navigation -->
      <nav aria-label="Breadcrumb" style="margin-bottom: 1.5rem; font-size: 0.8125rem; color: var(--text-muted);">
        <a href="/" style="color: var(--text-muted); text-decoration: none;">Home</a>
        <span style="margin-inline: 6px;">/</span>
        <span style="color: var(--text-secondary);">Authors</span>
        <span style="margin-inline: 6px;">/</span>
        <span style="color: var(--text-primary); font-weight: 600;">{author.name}</span>
      </nav>

      <!-- Author Bio Hero Header -->
      <article class="suite-card" style="padding: 2rem; margin-bottom: 2rem; border-left: 4px solid var(--accent-primary);">
        <div style="display: flex; gap: 1.5rem; align-items: flex-start; flex-wrap: wrap;">
          {author.avatar_url && (
            <img
              src={author.avatar_url}
              alt={author.name}
              style="width: 100px; height: 100px; border-radius: 50%; object-fit: cover; border: 2px solid var(--border-subtle);"
              loading="lazy"
            />
          )}
          <div style="flex: 1; min-width: 250px;">
            <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin-bottom: 6px;">
              <h1 style="font-size: 1.75rem; font-weight: 700; margin: 0;">{author.name}</h1>
              {author.nationality && (
                <span class="suite-badge" style="font-size: 0.75rem;">{author.nationality}</span>
              )}
            </div>

            <p style="font-size: 0.9375rem; color: var(--accent-primary); font-weight: 600; margin-bottom: 8px;">
              {author.profession} &bull; {author.born_year || "Unknown"} – {author.died_year || "Present"}
            </p>

            <p style="font-size: 0.9375rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 12px;">
              {author.bio}
            </p>

            {author.wikipedia_url && (
              <a
                href={author.wikipedia_url}
                target="_blank"
                rel="noopener noreferrer"
                style="font-size: 0.8125rem; color: var(--text-muted); text-decoration: underline;"
              >
                Read Wikipedia Biography &rarr;
              </a>
            )}
          </div>
        </div>
      </article>

      <!-- Monetization: Contextual Book Recommendation -->
      <Fragment set:html={affiliateCard} />

      <!-- Quotes Listing -->
      <section style="margin-top: 2rem;">
        <h2 style="font-size: 1.375rem; font-weight: 700; margin-bottom: 1.25rem;">
          Memorable Quotes by {author.name} ({quotes.length})
        </h2>

        <div style="display: flex; flex-direction: column; gap: 1.25rem;">
          {quotes.map((quote) => (
            <div class="suite-card" style="padding: 1.5rem; border: 1px solid var(--border-subtle); position: relative;">
              <blockquote style="margin: 0 0 1rem 0; font-size: 1.125rem; font-style: italic; line-height: 1.6; color: var(--text-primary);">
                "{quote.quote_text}"
              </blockquote>

              <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; font-size: 0.8125rem;">
                <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                  {quote.work_title && (
                    <span style="color: var(--text-muted); font-style: italic;">
                      From: {quote.work_title} {quote.work_year ? `(${quote.work_year})` : ""}
                    </span>
                  )}
                  {quote.mood_tags.map((mood) => (
                    <a href={`/mood/${mood}`} style="text-decoration: none;">
                      <span class="suite-badge" style="font-size: 0.6875rem;">#{mood}</span>
                    </a>
                  ))}
                  {quote.occasion_tags.map((occ) => (
                    <a href={`/occasion/${occ}`} style="text-decoration: none;">
                      <span class="suite-badge" style="font-size: 0.6875rem;">🏷️ {occ}</span>
                    </a>
                  ))}
                </div>

                <div style="display: flex; gap: 8px;">
                  <button
                    type="button"
                    class="suite-btn-secondary"
                    style="font-size: 0.75rem; padding: 4px 10px;"
                    onclick={`navigator.clipboard.writeText("${quote.quote_text.replace(/"/g, '\\"')} — ${author.name}"); alert("Copied to clipboard!");`}
                  >
                    📋 Copy
                  </button>
                  <a
                    href={`/?quote=${encodeURIComponent(quote.quote_text)}&author=${encodeURIComponent(author.name)}`}
                    class="suite-btn-primary"
                    style="font-size: 0.75rem; padding: 4px 10px; text-decoration: none;"
                  >
                    🎨 Create Wallpaper
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Monetization: AdSlot Zero-CLS -->
      <section style="margin-top: 2.5rem;">
        <Fragment set:html={adSlot} />
      </section>
    </main>

    <Fragment set:html={renderFooterHTML({ authorName: "VerbaLogos Editorial", currentYear: 2026, privacyUrl: "/privacy-policy", termsUrl: "/terms-of-service", editorialUrl: "/editorial-policy", contactUrl: "/contact" })} />
    <Fragment set:html={renderConsentBannerHTML()} />
  </body>
</html>
