---
import "@suite/ui-theme/base.css";
import { getAntiFOUCScript, renderHeaderHTML, renderFooterHTML } from "@suite/ui-theme";
import { renderMetaTags, buildFAQSchema, buildBreadcrumbSchema, buildWebApplicationSchema } from "@suite/seo-core";
import { renderAdSlotHTML, renderAffiliateCardHTML, renderConsentBannerHTML, getConsentModeScript } from "@suite/monetization";
import { DEV_TOOLS } from "../lib/dev-engine.ts";

const siteTitle = "DevWorkbench | Local-First Developer & Security Utilities";
const canonicalUrl = Astro.site ? Astro.site.href : "https://dev-workbench.suite.local/";
const description = "Debug JWTs, format and validate JSON, compute cryptographic hashes (SHA-256/512), convert Base64/Hex, and generate UUIDs. 100% private, client-side, zero cloud telemetry.";

const metaHtml = renderMetaTags({
  title: siteTitle,
  description,
  canonicalUrl,
  siteName: "DevWorkbench",
  type: "website",
});

const appSchema = buildWebApplicationSchema({
  name: "DevWorkbench",
  url: canonicalUrl,
  description,
  applicationCategory: "DeveloperApplication",
});

const faqs = [
  {
    question: "Do my sensitive API keys, JWT secrets, or tokens get logged on a server?",
    answer: "No. Never. DevWorkbench executes 100% locally in your browser memory using native Web Crypto APIs. No tokens, secrets, or payloads are ever dispatched to any remote server or cloud logging infrastructure.",
  },
  {
    question: "How fast is hash calculation on large payloads?",
    answer: "All hashing (SHA-256, SHA-512) and HMAC signatures utilize hardware-accelerated Web Crypto API (crypto.subtle), achieving near-native C-level speed directly within the browser runtime.",
  },
  {
    question: "Is DevWorkbench free and open for production use?",
    answer: "Yes, all tools are 100% free with zero registration barriers, no rate limits, and zero Cumulative Layout Shift (CLS=0.000).",
  },
];

const faqSchema = buildFAQSchema(faqs);
const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Home", url: canonicalUrl },
]);

const adSlotTop = renderAdSlotHTML({
  client: "ca-pub-0000000000000000",
  slotId: "8001001001",
  format: "leaderboard",
  testMode: true,
});

const adSlotBottom = renderAdSlotHTML({
  client: "ca-pub-0000000000000000",
  slotId: "8001001002",
  format: "rectangle",
  testMode: true,
});

const affiliateOffer = renderAffiliateCardHTML({
  title: "1Password Developer Tools — Secrets Automation",
  description: "Secure SSH keys, API credentials, and environment variables across your entire dev stack and CI/CD pipelines.",
  ctaText: "Get 1Password Developer",
  affiliateUrl: "https://partner.suite.local/1password-dev",
  merchantName: "1Password Partner Network",
  badge: "Security Standard",
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Fragment set:html={metaHtml} />
    <Fragment set:html={getAntiFOUCScript()} />
    <Fragment set:html={getConsentModeScript()} />
    <Fragment set:html={appSchema} />
    <Fragment set:html={faqSchema} />
    <Fragment set:html={breadcrumbSchema} />
    <style>
      .hero-section {
        text-align: center;
        padding: 3rem 1rem 2rem;
        max-width: 900px;
        margin: 0 auto;
      }
      .security-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(14, 165, 233, 0.1);
        color: #0284c7;
        font-weight: 700;
        font-size: 0.85rem;
        padding: 0.35rem 0.85rem;
        border-radius: 9999px;
        margin-bottom: 1rem;
        border: 1px solid rgba(14, 165, 233, 0.25);
      }
      .hero-title {
        font-size: 2.75rem;
        font-weight: 900;
        letter-spacing: -0.03em;
        line-height: 1.15;
        margin-bottom: 1rem;
      }
      .hero-subtitle {
        font-size: 1.2rem;
        color: #64748b;
        max-width: 720px;
        margin: 0 auto 2rem;
        line-height: 1.6;
      }
      .workbench-demo {
        background: #0f172a;
        color: #f8fafc;
        border-radius: 1rem;
        padding: 2rem;
        text-align: left;
        max-width: 800px;
        margin: 1.5rem auto 2.5rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      }
      .demo-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #334155;
        padding-bottom: 0.75rem;
        margin-bottom: 1rem;
        font-size: 0.85rem;
        color: #94a3b8;
      }
      .demo-output {
        font-size: 0.95rem;
        line-height: 1.6;
        color: #38bdf8;
      }
      .tools-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
        max-width: 1000px;
        margin: 2.5rem auto;
      }
      .tool-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 0.85rem;
        padding: 1.75rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        text-align: left;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }
      .tool-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.06);
      }
      .tool-badge {
        align-self: flex-start;
        font-size: 0.72rem;
        font-weight: 800;
        text-transform: uppercase;
        background: #f1f5f9;
        color: #475569;
        padding: 0.2rem 0.5rem;
        border-radius: 0.35rem;
        margin-bottom: 0.75rem;
      }
      .tool-icon {
        font-size: 2.25rem;
        margin-bottom: 0.75rem;
      }
      .tool-title {
        font-size: 1.25rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
        color: #0f172a;
      }
      .tool-desc {
        font-size: 0.92rem;
        color: #64748b;
        line-height: 1.5;
        margin-bottom: 1.25rem;
      }
      .tool-btn {
        display: inline-block;
        text-align: center;
        background: #0f172a;
        color: #ffffff;
        font-weight: 700;
        font-size: 0.9rem;
        padding: 0.7rem 1.2rem;
        border-radius: 0.5rem;
        text-decoration: none;
        transition: background 0.15s ease;
      }
      .tool-btn:hover {
        background: #0284c7;
      }
    </style>
  </head>
  <body>
    <Fragment set:html={renderHeaderHTML({ currentPath: "/" })} />

    <main class="container">
      <section class="hero-section">
        <div class="security-pill">
          <span>🛡️</span> Zero Cloud Telemetry — 100% In-Browser Web Crypto
        </div>
        <h1 class="hero-title">Developer & Security Utilities</h1>
        <p class="hero-subtitle">
          Debug JSON Web Tokens, compute SHA-256 hashes, format payloads, and encode codecs with client-side execution that never leaves your machine.
        </p>

        <!-- Zero-CLS Monetization Slot -->
        <div style="margin: 1.5rem 0 2rem;">
          <Fragment set:html={adSlotTop} />
        </div>

        <div class="workbench-demo">
          <div class="demo-header">
            <span>⚡ Interactive Quick Terminal</span>
            <span style="color: #4ade80;">● Web Crypto Ready</span>
          </div>
          <div class="demo-output">
            <span style="color: #94a3b8;">$ dev-workbench --status</span><br />
            ✓ SHA-256 / SHA-512: Hardware Accelerated<br />
            ✓ JWT Debugger: Local HMAC-SHA256 Ready<br />
            ✓ Multi-Codec: UTF-8 &lt;-&gt; Base64 &lt;-&gt; Hex Ready<br />
          </div>
        </div>
      </section>

      <!-- Tools Grid -->
      <section id="tools">
        <h2 style="text-align: center; font-size: 1.75rem; font-weight: 800; margin-bottom: 0.5rem;">Developer Utilities Catalog</h2>
        <p style="text-align: center; color: #64748b; margin-bottom: 2rem;">Zero rate limits, zero account sign-up, zero external data leakage</p>
        
        <div class="tools-grid">
          {DEV_TOOLS.map((tool) => (
            <article class="tool-card">
              <div>
                <span class="tool-badge">{tool.badge}</span>
                <div class="tool-icon">{tool.icon}</div>
                <h3 class="tool-title">{tool.title}</h3>
                <p class="tool-desc">{tool.description}</p>
              </div>
              <a href={`/tools/${tool.slug}`} class="tool-btn">
                Launch {tool.title} →
              </a>
            </article>
          ))}
        </div>
      </section>

      <!-- Affiliate Partner Section -->
      <section style="max-width: 800px; margin: 3rem auto;">
        <Fragment set:html={affiliateOffer} />
      </section>

      <!-- FAQs -->
      <section style="max-width: 800px; margin: 2.5rem auto;">
        <h2 style="text-align: center; font-size: 1.75rem; font-weight: 800; margin-bottom: 1.5rem;">Frequently Asked Questions</h2>
        {faqs.map((faq) => (
          <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 0.75rem; padding: 1.25rem 1.5rem; margin-bottom: 1rem;">
            <h3 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 0.5rem; color: #0f172a;">{faq.question}</h3>
            <p style="font-size: 0.92rem; color: #475569; margin: 0; line-height: 1.5;">{faq.answer}</p>
          </div>
        ))}
      </section>

      <!-- Zero-CLS Monetization Slot -->
      <div style="margin: 2.5rem 0;">
        <Fragment set:html={adSlotBottom} />
      </div>
    </main>

    <Fragment set:html={renderFooterHTML()} />
    <Fragment set:html={renderConsentBannerHTML()} />
  </body>
</html>
