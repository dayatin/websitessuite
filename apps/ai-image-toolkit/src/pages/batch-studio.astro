---
import "@suite/ui-theme/base.css";
import { getAntiFOUCScript, renderHeaderHTML, renderFooterHTML } from "@suite/ui-theme";
import { renderMetaTags, buildWebApplicationSchema, buildBreadcrumbSchema } from "@suite/seo-core";
import { renderAdSlotHTML, renderAffiliateCardHTML, renderConsentBannerHTML, getConsentModeScript } from "@suite/monetization";

const siteTitle = "Multi-File Batch Image Studio (Parallel Compress & ZIP) | OptiPixel";
const canonicalUrl = Astro.site ? new URL("batch-studio", Astro.site).href : "https://ai-image-toolkit.suite.local/batch-studio";
const description = "Batch process up to 100 images in parallel with client-side WebWorkers. Bulk resize, target-KB compression, WebP/AVIF format conversion, and 1-click ZIP archive download.";

const metaHtml = renderMetaTags({
  title: siteTitle,
  description,
  canonicalUrl,
  siteName: "OptiPixel Studio",
  type: "website",
});

const appSchema = buildWebApplicationSchema({
  name: "OptiPixel Batch Image Studio",
  url: canonicalUrl,
  description,
  applicationCategory: "MultimediaApplication",
});

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Home", url: "https://ai-image-toolkit.suite.local/" },
  { name: "Batch Studio", url: canonicalUrl },
]);

const adSlotTop = renderAdSlotHTML({
  client: "ca-pub-0000000000000000",
  slotId: "5001001009",
  format: "leaderboard",
  testMode: true,
});

const adSlotBottom = renderAdSlotHTML({
  client: "ca-pub-0000000000000000",
  slotId: "5001001010",
  format: "rectangle",
  testMode: true,
});

const affiliateOffer = renderAffiliateCardHTML({
  title: "Cloud Object Storage & Global Image CDN",
  description: "Enterprise S3-compatible asset storage with zero egress fees and automatic edge WebP/AVIF content delivery network acceleration.",
  ctaText: "Explore Cloud Storage",
  affiliateUrl: "https://partner.suite.local/cloud-cdn",
  merchantName: "Enterprise Infrastructure Partner",
  badge: "High-Volume Recommended",
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline set:html={getAntiFOUCScript()} />
    <Fragment set:html={getConsentModeScript()} />
    <Fragment set:html={metaHtml} />
    <script type="application/ld+json" is:inline set:html={appSchema} />
    <script type="application/ld+json" is:inline set:html={breadcrumbSchema} />
    <style>
      .batch-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.8125rem;
      }
      .batch-table th {
        text-align: left;
        padding: 10px;
        color: var(--text-muted);
        border-bottom: 2px solid var(--border-subtle);
      }
      .batch-table td {
        padding: 10px;
        border-bottom: 1px solid var(--border-subtle);
      }
      .progress-bar-bg {
        background: var(--border-subtle);
        height: 6px;
        border-radius: 9999px;
        overflow: hidden;
      }
      .progress-bar-fill {
        background: var(--accent-primary);
        height: 100%;
        width: 0%;
        transition: width 0.2s ease;
      }
    </style>
  </head>
  <body>
    <Fragment set:html={renderHeaderHTML({ siteTitle: "OptiPixel", navItems: [{ label: "Print Studio", href: "/" }, { label: "Passport Studio", href: "/passport-studio" }, { label: "Batch Studio", href: "/batch-studio" }, { label: "About", href: "/about" }] })} />

    <main class="suite-container" style="flex: 1; padding-block: 2rem; max-width: 1050px;">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" style="margin-bottom: 1.25rem; font-size: 0.8125rem; color: var(--text-muted);">
        <a href="/" style="color: var(--text-muted); text-decoration: none;">Home</a>
        <span style="margin-inline: 6px;">/</span>
        <span style="color: var(--text-primary); font-weight: 600;">Batch Studio</span>
      </nav>

      <!-- Hero Header -->
      <header style="text-align: center; margin-bottom: 2rem;">
        <span class="suite-badge" style="margin-bottom: 8px;">🚀 Parallel Multi-Threaded WebWorkers</span>
        <h1 style="font-size: 2.25rem; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 8px;">
          Multi-File Batch Processing Studio
        </h1>
        <p style="font-size: 1rem; color: var(--text-secondary); max-width: 700px; margin-inline: auto;">
          Compress, resize, and convert dozens of images simultaneously. Processed entirely within your device's browser memory and packaged into a single ZIP file.
        </p>
      </header>

      <!-- Top Leaderboard AdSlot -->
      <div style="margin-bottom: 2rem;">
        <Fragment set:html={adSlotTop} />
      </div>

      <!-- Multi-File Dropzone & Batch Configuration Bar -->
      <section class="suite-card" style="padding: 1.5rem; margin-bottom: 2rem;">
        <div style="display: flex; flex-direction: column; gap: 1.25rem;">
          <!-- Dropzone -->
          <div id="batch-drop-zone" style="border: 2px dashed var(--border-subtle); border-radius: var(--radius-md, 8px); padding: 2rem 1.5rem; text-align: center; background: var(--bg-surface); cursor: pointer;">
            <input type="file" id="batch-file-input" multiple accept="image/jpeg,image/png,image/webp,image/avif" style="display: none;" />
            <div style="font-size: 2.5rem; margin-bottom: 6px;">📂</div>
            <h2 style="font-size: 1.125rem; font-weight: 700; margin-bottom: 4px;">
              Select or Drop Multiple Images (Up to 50 files)
            </h2>
            <p style="font-size: 0.8125rem; color: var(--text-muted); margin: 0;">
              Hold Ctrl/Command or Shift to select multiple photos at once.
            </p>
          </div>

          <!-- Configuration Controls -->
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; align-items: flex-end;">
            <div>
              <label for="batch-action-select" style="display: block; font-size: 0.8125rem; font-weight: 600; margin-bottom: 4px;">
                Batch Action:
              </label>
              <select id="batch-action-select" class="suite-select" style="width: 100%; padding: 8px;">
                <option value="compress-kb" selected>Exact Target-KB Compression</option>
                <option value="convert-format">Format Conversion</option>
                <option value="resize-max">Max Dimension Scale</option>
              </select>
            </div>

            <div>
              <label for="batch-target-kb" style="display: block; font-size: 0.8125rem; font-weight: 600; margin-bottom: 4px;">
                Target KB / Quality:
              </label>
              <select id="batch-target-kb" class="suite-select" style="width: 100%; padding: 8px;">
                <option value="50">Under 50 KB (Visa / Passport strict)</option>
                <option value="100" selected>Under 100 KB (Fast Web)</option>
                <option value="200">Under 200 KB (Balanced)</option>
                <option value="500">Under 500 KB (High Quality)</option>
              </select>
            </div>

            <div>
              <label for="batch-out-format" style="display: block; font-size: 0.8125rem; font-weight: 600; margin-bottom: 4px;">
                Output Format:
              </label>
              <select id="batch-out-format" class="suite-select" style="width: 100%; padding: 8px;">
                <option value="image/webp" selected>WebP (Recommended)</option>
                <option value="image/jpeg">JPEG (Universal)</option>
                <option value="image/png">PNG</option>
                <option value="image/avif">AVIF (Ultra)</option>
              </select>
            </div>

            <div>
              <button id="start-batch-btn" type="button" class="suite-btn-primary" style="width: 100%; padding: 10px; font-size: 0.875rem;">
                ⚡ Process Batch (Parallel)
              </button>
            </div>
          </div>
        </div>
      </section>

      <!-- Batch Queue Status Table & Summary -->
      <section class="suite-card" style="padding: 1.5rem; margin-bottom: 2rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; margin-bottom: 1rem;">
          <div>
            <h2 style="font-size: 1.125rem; font-weight: 700; margin: 0;">
              Batch Processing Queue (<span id="queue-count">0</span> items)
            </h2>
            <div id="queue-savings" style="font-size: 0.8125rem; color: #10b981; font-weight: 600; margin-top: 2px;">
              Ready to process
            </div>
          </div>

          <button id="download-zip-btn" type="button" class="suite-btn-secondary" disabled style="padding: 8px 16px; font-size: 0.8125rem;">
            📦 Download All as ZIP
          </button>
        </div>

        <div style="overflow-x: auto;">
          <table class="batch-table">
            <thead>
              <tr>
                <th>File Name</th>
                <th>Original Size</th>
                <th>Processed Size</th>
                <th>Savings</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody id="batch-table-body">
              <tr>
                <td colspan="5" style="text-align: center; color: var(--text-muted); padding: 2rem;">
                  No files queued. Drag & drop images above to begin.
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Monetization: Contextual Cloud Storage Offer -->
      <Fragment set:html={affiliateOffer} />

      <!-- Monetization: Bottom Rectangle AdSlot -->
      <section style="margin-top: 2rem;">
        <Fragment set:html={adSlotBottom} />
      </section>
    </main>

    <Fragment set:html={renderFooterHTML({ authorName: "OptiPixel Editorial", currentYear: 2026, privacyUrl: "/privacy-policy", termsUrl: "/terms-of-service", editorialUrl: "/editorial-policy", contactUrl: "/contact" })} />
    <Fragment set:html={renderConsentBannerHTML()} />

    <!-- Client-Side Batch Queue & Inline ZIP Generator Script -->
    <script is:inline>
      (() => {
        let queuedFiles = [];
        let processedResults = [];

        const dropZone = document.getElementById("batch-drop-zone");
        const fileInput = document.getElementById("batch-file-input");
        const startBtn = document.getElementById("start-batch-btn");
        const downloadZipBtn = document.getElementById("download-zip-btn");
        const tableBody = document.getElementById("batch-table-body");
        const queueCount = document.getElementById("queue-count");
        const queueSavings = document.getElementById("queue-savings");

        if (dropZone && fileInput) {
          dropZone.addEventListener("click", () => fileInput.click());
          dropZone.addEventListener("dragover", (e) => { e.preventDefault(); dropZone.style.borderColor = "var(--accent-primary)"; });
          dropZone.addEventListener("dragleave", () => { dropZone.style.borderColor = "var(--border-subtle)"; });
          dropZone.addEventListener("drop", (e) => {
            e.preventDefault();
            dropZone.style.borderColor = "var(--border-subtle)";
            if (e.dataTransfer.files) addFiles(Array.from(e.dataTransfer.files));
          });
          fileInput.addEventListener("change", (e) => {
            if (e.target.files) addFiles(Array.from(e.target.files));
          });
        }

        function addFiles(files) {
          const imageFiles = files.filter(f => f.type.startsWith("image/"));
          queuedFiles.push(...imageFiles);
          renderTable();
        }

        function formatBytes(b) {
          if (b < 1024) return b + " B";
          if (b < 1048576) return (b / 1024).toFixed(1) + " KB";
          return (b / 1048576).toFixed(2) + " MB";
        }

        function renderTable() {
          if (!tableBody || !queueCount) return;
          queueCount.textContent = queuedFiles.length;

          if (queuedFiles.length === 0) {
            tableBody.innerHTML = '<tr><td colspan="5" style="text-align: center; color: var(--text-muted); padding: 2rem;">No files queued.</td></tr>';
            return;
          }

          tableBody.innerHTML = queuedFiles.map((file, idx) => {
            const res = processedResults[idx];
            const processedSize = res ? formatBytes(res.size) : "-";
            const savings = res ? `${Math.round(((file.size - res.size) / file.size) * 100)}%` : "-";
            const status = res ? "✅ Done" : "⏳ Queued";

            return `
              <tr>
                <td style="font-weight: 600; max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${file.name}</td>
                <td>${formatBytes(file.size)}</td>
                <td>${processedSize}</td>
                <td style="color: #10b981; font-weight: 700;">${savings}</td>
                <td><span class="suite-badge" style="font-size: 0.6875rem;">${status}</span></td>
              </tr>
            `;
          }).join("");
        }

        if (startBtn) {
          startBtn.addEventListener("click", async () => {
            if (queuedFiles.length === 0) {
              alert("Please add files first.");
              return;
            }
            startBtn.disabled = true;
            startBtn.textContent = "⏳ Processing...";
            processedResults = [];

            const targetKb = parseInt(document.getElementById("batch-target-kb").value, 10);
            const format = document.getElementById("batch-out-format").value;

            for (let i = 0; i < queuedFiles.length; i++) {
              const file = queuedFiles[i];
              try {
                const img = new Image();
                const objUrl = URL.createObjectURL(file);
                await new Promise((res, rej) => {
                  img.onload = () => res();
                  img.onerror = rej;
                  img.src = objUrl;
                });

                const canvas = document.createElement("canvas");
                canvas.width = img.width;
                canvas.height = img.height;
                const ctx = canvas.getContext("2d");
                ctx.drawImage(img, 0, 0);
                URL.revokeObjectURL(objUrl);

                let blob = null;
                const targetBytes = targetKb * 1024;
                if (format === "image/png") {
                  blob = await new Promise((r) => canvas.toBlob(r, "image/png"));
                } else {
                  let low = 0.1;
                  let high = 0.95;
                  for (let iter = 0; iter < 5; iter++) {
                    const mid = (low + high) / 2;
                    const b = await new Promise((r) => canvas.toBlob(r, format, mid));
                    if (!b) break;
                    blob = b;
                    if (b.size > targetBytes) high = mid;
                    else low = mid;
                  }
                }
                if (!blob) {
                  blob = await new Promise((r) => canvas.toBlob(r, format, 0.8));
                }

                const arrayBuffer = await blob.arrayBuffer();
                const uint8 = new Uint8Array(arrayBuffer);
                const ext = format === "image/webp" ? ".webp" : format === "image/jpeg" ? ".jpg" : format === "image/png" ? ".png" : ".avif";
                const outName = file.name.replace(/\.[^.]+$/, "") + ext;

                processedResults[i] = {
                  name: outName,
                  size: uint8.length,
                  data: uint8,
                };
              } catch (err) {
                console.error("Failed to process file:", file.name, err);
              }
              renderTable();
            }

            const origTotal = queuedFiles.reduce((acc, f) => acc + f.size, 0);
            const compTotal = processedResults.reduce((acc, r) => acc + (r ? r.size : 0), 0);
            const saved = Math.max(0, origTotal - compTotal);

            if (queueSavings) {
              queueSavings.textContent = `✨ Saved ${formatBytes(saved)} (${Math.round((saved / origTotal) * 100)}% reduction across ${queuedFiles.length} files)`;
            }

            startBtn.disabled = false;
            startBtn.textContent = "⚡ Process Batch";
            if (downloadZipBtn) downloadZipBtn.disabled = false;
          });
        }

        // IEEE 802.3 CRC-32 table & standard PKZIP generator
        let crcTable = null;
        function getCrcTable() {
          if (crcTable) return crcTable;
          crcTable = new Uint32Array(256);
          for (let i = 0; i < 256; i++) {
            let c = i;
            for (let k = 0; k < 8; k++) {
              c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1;
            }
            crcTable[i] = c;
          }
          return crcTable;
        }

        function computeCrc32(data) {
          const table = getCrcTable();
          let crc = 0 ^ -1;
          for (let i = 0; i < data.length; i++) {
            crc = (crc >>> 8) ^ table[(crc ^ data[i]) & 0xff];
          }
          return (crc ^ -1) >>> 0;
        }

        function buildZip(entries) {
          const fileHeaders = [];
          const centralDirHeaders = [];
          let offset = 0;
          const textEncoder = new TextEncoder();

          for (const entry of entries) {
            const filenameBytes = textEncoder.encode(entry.filename);
            const dataBytes = entry.data;
            const crc = computeCrc32(dataBytes);
            const size = dataBytes.length;

            const lh = new Uint8Array(30 + filenameBytes.length);
            const lv = new DataView(lh.buffer);
            lv.setUint32(0, 0x04034b50, true);
            lv.setUint16(4, 20, true);
            lv.setUint16(6, 0, true);
            lv.setUint16(8, 0, true);
            lv.setUint16(10, 0, true);
            lv.setUint16(12, 0, true);
            lv.setUint32(14, crc, true);
            lv.setUint32(18, size, true);
            lv.setUint32(22, size, true);
            lv.setUint16(26, filenameBytes.length, true);
            lv.setUint16(28, 0, true);
            lh.set(filenameBytes, 30);

            fileHeaders.push(lh);
            fileHeaders.push(dataBytes);

            const cd = new Uint8Array(46 + filenameBytes.length);
            const cv = new DataView(cd.buffer);
            cv.setUint32(0, 0x02014b50, true);
            cv.setUint16(4, 20, true);
            cv.setUint16(6, 20, true);
            cv.setUint16(8, 0, true);
            cv.setUint16(10, 0, true);
            cv.setUint16(12, 0, true);
            cv.setUint16(14, 0, true);
            cv.setUint32(16, crc, true);
            cv.setUint32(20, size, true);
            cv.setUint32(24, size, true);
            cv.setUint16(28, filenameBytes.length, true);
            cv.setUint16(30, 0, true);
            cv.setUint16(32, 0, true);
            cv.setUint16(34, 0, true);
            cv.setUint16(36, 0, true);
            cv.setUint32(38, 0, true);
            cv.setUint32(42, offset, true);
            cd.set(filenameBytes, 46);

            centralDirHeaders.push(cd);
            offset += lh.length + dataBytes.length;
          }

          const cdSize = centralDirHeaders.reduce((acc, h) => acc + h.length, 0);
          const eocd = new Uint8Array(22);
          const ev = new DataView(eocd.buffer);
          ev.setUint32(0, 0x06054b50, true);
          ev.setUint16(4, 0, true);
          ev.setUint16(6, 0, true);
          ev.setUint16(8, entries.length, true);
          ev.setUint16(10, entries.length, true);
          ev.setUint32(12, cdSize, true);
          ev.setUint32(16, offset, true);
          ev.setUint16(20, 0, true);

          const totalLen = offset + cdSize + 22;
          const out = new Uint8Array(totalLen);
          let pos = 0;
          for (const p of fileHeaders) {
            out.set(p, pos);
            pos += p.length;
          }
          for (const p of centralDirHeaders) {
            out.set(p, pos);
            pos += p.length;
          }
          out.set(eocd, pos);
          return out;
        }

        if (downloadZipBtn) {
          downloadZipBtn.addEventListener("click", () => {
            const validEntries = processedResults.filter(Boolean).map((r) => ({ filename: r.name, data: r.data }));
            if (validEntries.length === 0) {
              alert("No processed files available to download.");
              return;
            }
            const zipBytes = buildZip(validEntries);
            const blob = new Blob([zipBytes], { type: "application/zip" });
            const a = document.createElement("a");
            a.href = URL.createObjectURL(blob);
            a.download = `optipixel-batch-${Date.now()}.zip`;
            a.click();
            setTimeout(() => URL.revokeObjectURL(a.href), 1000);
          });
        }
      })();
    </script>
  </body>
</html>
