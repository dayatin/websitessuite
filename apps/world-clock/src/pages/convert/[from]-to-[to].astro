---
import "@suite/ui-theme/base.css";
import { getAntiFOUCScript, renderHeaderHTML, renderFooterHTML } from "@suite/ui-theme";
import { renderMetaTags, buildFAQSchema, buildBreadcrumbSchema } from "@suite/seo-core";
import { renderAdSlotHTML, renderAffiliateCardHTML, renderConsentBannerHTML, getConsentModeScript } from "@suite/monetization";
import {
  PAIRWISE_ROUTES,
  buildPairwiseTable,
  generatePairwiseFAQs,
} from "../../lib/pairwise-matrix.ts";
import { getStatusStyle } from "../../lib/timeline-math.ts";

export function getStaticPaths() {
  return PAIRWISE_ROUTES.map((route) => ({
    params: { from: route.fromSlug, to: route.toSlug },
    props: { route },
  }));
}

const { route } = Astro.props;
const today = new Date();
const { rows, offsetSummary } = buildPairwiseTable(route, today);
const faqs = generatePairwiseFAQs(route, offsetSummary);

const siteTitle = `${route.fromName} to ${route.toName} Converter & Time Difference | ChronoSpatial`;
const canonicalUrl = Astro.site
  ? new URL(`convert/${route.fromSlug}-to-${route.toSlug}`, Astro.site).href
  : `https://world-clock.suite.local/convert/${route.fromSlug}-to-${route.toSlug}`;
const description = `Convert time between ${route.fromName} and ${route.toName}. Full 24-hour comparison chart, current time difference (${offsetSummary}), and best overlap hours.`;

const metaHtml = renderMetaTags({
  title: siteTitle,
  description,
  canonicalUrl,
  siteName: "ChronoSpatial",
  type: "article",
});

const faqSchema = buildFAQSchema(faqs);
const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Home", url: "https://world-clock.suite.local/" },
  { name: "Converters", url: "https://world-clock.suite.local/#converters" },
  { name: `${route.fromSlug.toUpperCase()} to ${route.toSlug.toUpperCase()}`, url: canonicalUrl },
]);

const adSlot = renderAdSlotHTML({
  client: "ca-pub-0000000000000000",
  slotId: "4001001004",
  format: "rectangle",
  testMode: true,
});

const affiliateOffer = renderAffiliateCardHTML({
  title: "Cross-Border Payments & Global Team Payroll",
  description: "Pay international team members and contractors in 70+ currencies at real mid-market exchange rates without hidden bank markups.",
  ctaText: "Explore Global Payroll",
  affiliateUrl: "https://partner.suite.local/global-payroll",
  merchantName: "International Finance Partner",
  badge: "Global Remote Partner",
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline set:html={getAntiFOUCScript()} />
    <Fragment set:html={getConsentModeScript()} />
    <Fragment set:html={metaHtml} />
    <script type="application/ld+json" is:inline set:html={faqSchema} />
    <script type="application/ld+json" is:inline set:html={breadcrumbSchema} />
  </head>
  <body>
    <Fragment set:html={renderHeaderHTML({ siteTitle: "ChronoSpatial", navItems: [{ label: "World Clock", href: "/" }, { label: "Meeting Planner", href: "/meet" }, { label: "Converters", href: "/" }, { label: "About", href: "/about" }] })} />

    <main class="suite-container" style="flex: 1; padding-block: 2rem; max-width: 900px;">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" style="margin-bottom: 1.25rem; font-size: 0.8125rem; color: var(--text-muted);">
        <a href="/" style="color: var(--text-muted); text-decoration: none;">Home</a>
        <span style="margin-inline: 6px;">/</span>
        <span style="color: var(--text-secondary);">Converters</span>
        <span style="margin-inline: 6px;">/</span>
        <span style="color: var(--text-primary); font-weight: 600;">{route.fromSlug.toUpperCase()} to {route.toSlug.toUpperCase()}</span>
      </nav>

      <!-- Conversion Header Hero -->
      <header class="suite-card" style="padding: 2rem; margin-bottom: 2rem; border-top: 4px solid var(--accent-primary);">
        <span class="suite-badge" style="font-size: 0.75rem; margin-bottom: 8px;">🔄 Timezone Conversion Matrix</span>
        <h1 style="font-size: 1.875rem; font-weight: 800; margin: 4px 0 8px 0;">
          {route.fromName} to {route.toName}
        </h1>
        <p style="font-size: 1rem; color: var(--text-secondary); margin-bottom: 1.25rem;">
          {route.description}
        </p>

        <!-- Summary Offset Box -->
        <div style="background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: var(--radius-sm, 6px); padding: 12px 16px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; margin-bottom: 1.5rem;">
          <div style="display: flex; align-items: center; gap: 8px;">
            <span style="font-size: 1.25rem;">⏱️</span>
            <strong style="color: var(--text-primary);">{offsetSummary}</strong>
          </div>
          <a
            href={`/meet?title=${encodeURIComponent(`Meeting: ${route.fromSlug.toUpperCase()} and ${route.toSlug.toUpperCase()}`)}&host=${route.fromSlug}&cities=${route.toSlug}`}
            class="suite-btn-primary"
            style="font-size: 0.8125rem; padding: 6px 14px; text-decoration: none;"
          >
            📅 Plan Meeting in These Zones
          </a>
        </div>

        <!-- Live Interactive Pairwise Converter Tool -->
        <div style="background: var(--bg-surface-hover, rgba(255,255,255,0.02)); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm, 6px); padding: 1.25rem;">
          <div style="font-size: 0.875rem; font-weight: 700; margin-bottom: 12px; color: var(--text-primary); display: flex; align-items: center; justify-content: space-between;">
            <span>⚡ Live Custom Time Converter</span>
            <span id="pw-status-badge" class="suite-badge" style="font-size: 0.6875rem;">Interactive</span>
          </div>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; align-items: end; margin-bottom: 1rem;">
            <div>
              <label for="pw-time-input" style="display: block; font-size: 0.75rem; font-weight: 600; color: var(--text-secondary); margin-bottom: 4px;">
                Time in {route.fromName}
              </label>
              <input id="pw-time-input" type="time" class="suite-input" value="12:00" style="width: 100%; padding: 8px 12px; font-size: 0.875rem;" />
            </div>

            <div>
              <label for="pw-date-input" style="display: block; font-size: 0.75rem; font-weight: 600; color: var(--text-secondary); margin-bottom: 4px;">
                Date
              </label>
              <input id="pw-date-input" type="date" class="suite-input" style="width: 100%; padding: 8px 12px; font-size: 0.875rem;" />
            </div>

            <div style="display: flex; gap: 8px;">
              <button id="pw-now-btn" type="button" class="suite-btn-secondary" style="font-size: 0.8125rem; padding: 8px 12px; flex: 1;">
                Current Time
              </button>
            </div>
          </div>

          <!-- Live Conversion Output Result -->
          <div id="pw-result-banner" style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.25); border-radius: 4px; padding: 12px; text-align: center;">
            <div id="pw-result-text" style="font-size: 1.25rem; font-weight: 800; color: var(--text-primary);">
              12:00 PM in {route.fromName} = ...
            </div>
            <div id="pw-result-sub" style="font-size: 0.8125rem; color: var(--text-secondary); margin-top: 4px;">
              Calculating instant conversion...
            </div>
          </div>
        </div>
      </header>

      <!-- 24-Hour Comparison Table -->
      <section class="suite-card" style="padding: 1.5rem; margin-bottom: 2rem;">
        <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1rem;">
          24-Hour Side-by-Side Conversion Chart
        </h2>

        <div style="overflow-x: auto;">
          <table style="width: 100%; border-collapse: collapse; font-size: 0.875rem;">
            <thead>
              <tr style="border-bottom: 2px solid var(--border-subtle); text-align: left;">
                <th style="padding: 10px; color: var(--text-muted); font-size: 0.75rem;">{route.fromName}</th>
                <th style="padding: 10px; color: var(--text-muted); font-size: 0.75rem;">{route.toName}</th>
                <th style="padding: 10px; color: var(--text-muted); font-size: 0.75rem;">Day Shift</th>
                <th style="padding: 10px; color: var(--text-muted); font-size: 0.75rem;">Working Overlap</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((row) => {
                const fStyle = getStatusStyle(row.fromStatus as any);
                const tStyle = getStatusStyle(row.toStatus as any);
                const isBothWork = row.fromStatus === "work" && row.toStatus === "work";

                return (
                  <tr style={`border-bottom: 1px solid var(--border-subtle); ${isBothWork ? "background: rgba(16, 185, 129, 0.08);" : ""}`}>
                    <td style="padding: 10px; font-weight: 600;">
                      {row.fromTimeFormatted}
                      <span style={`font-size: 0.6875rem; margin-left: 6px; color: ${fStyle.fg};`}>({row.fromStatus})</span>
                    </td>
                    <td style="padding: 10px; font-weight: 600;">
                      {row.toTimeFormatted}
                      <span style={`font-size: 0.6875rem; margin-left: 6px; color: ${tStyle.fg};`}>({row.toStatus})</span>
                    </td>
                    <td style="padding: 10px; font-size: 0.75rem; color: var(--text-muted);">
                      {row.dayShiftLabel}
                    </td>
                    <td style="padding: 10px;">
                      {isBothWork ? (
                        <span style="font-size: 0.75rem; font-weight: 700; color: #10b981;">
                          ✨ Prime Work Overlap
                        </span>
                      ) : (
                        <span style="font-size: 0.75rem; color: var(--text-muted);">
                          Normal
                        </span>
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Frequently Asked Questions (FAQPage) -->
      <section class="suite-card" style="padding: 1.5rem; margin-bottom: 2rem;">
        <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1.25rem;">
          Frequently Asked Questions
        </h2>

        <div style="display: flex; flex-direction: column; gap: 1rem;">
          {faqs.map((faq) => (
            <div style="border-bottom: 1px solid var(--border-subtle); padding-bottom: 1rem;">
              <h3 style="font-size: 1rem; font-weight: 600; margin-bottom: 4px; color: var(--text-primary);">
                {faq.question}
              </h3>
              <p style="font-size: 0.875rem; color: var(--text-secondary); line-height: 1.5; margin: 0;">
                {faq.answer}
              </p>
            </div>
          ))}
        </div>
      </section>

      <!-- Monetization: Contextual Affiliate Offer -->
      <Fragment set:html={affiliateOffer} />

      <!-- Monetization: Zero-CLS AdSlot -->
      <section style="margin-top: 2rem;">
        <Fragment set:html={adSlot} />
      </section>
    </main>

    <Fragment set:html={renderFooterHTML({ authorName: "ChronoSpatial Team", currentYear: 2026, privacyUrl: "/privacy-policy", termsUrl: "/terms-of-service", editorialUrl: "/editorial-policy", contactUrl: "/contact" })} />
    <Fragment set:html={renderConsentBannerHTML()} />

    <script is:inline define:vars={{ fromTz: route.fromTz, toTz: route.toTz, fromName: route.fromName, toName: route.toName }}>
      (() => {
        const timeInput = document.getElementById("pw-time-input");
        const dateInput = document.getElementById("pw-date-input");
        const nowBtn = document.getElementById("pw-now-btn");
        const resultText = document.getElementById("pw-result-text");
        const resultSub = document.getElementById("pw-result-sub");

        if (dateInput) {
          dateInput.value = new Date().toISOString().split("T")[0];
        }

        function calculate() {
          if (!timeInput || !dateInput || !resultText || !resultSub) return;
          const [hStr, mStr] = timeInput.value.split(":");
          const h = Number.parseInt(hStr || "12", 10);
          const m = Number.parseInt(mStr || "0", 10);

          const [y, mo, d] = dateInput.value.split("-").map((v) => Number.parseInt(v, 10));
          const fakeUtc = new Date(Date.UTC(y, mo - 1, d, h, m, 0));

          // Get offset for fromTz
          const dtfFrom = new Intl.DateTimeFormat("en-US", {
            timeZone: fromTz,
            year: "numeric",
            month: "2-digit",
            day: "2-digit",
            hour: "2-digit",
            minute: "2-digit",
            second: "2-digit",
            hour12: false,
            timeZoneName: "short",
          });
          const partsFrom = dtfFrom.formatToParts(fakeUtc);
          const getP = (parts, t) => parts.find((p) => p.type === t)?.value || "0";
          const yF = Number.parseInt(getP(partsFrom, "year"), 10);
          const moF = Number.parseInt(getP(partsFrom, "month"), 10);
          const dF = Number.parseInt(getP(partsFrom, "day"), 10);
          const hF = Number.parseInt(getP(partsFrom, "hour"), 10) % 24;
          const mF = Number.parseInt(getP(partsFrom, "minute"), 10);

          const localDateAsUtc = new Date(Date.UTC(yF, moF - 1, dF, hF, mF, 0));
          const offsetMinutes = Math.round((localDateAsUtc.getTime() - fakeUtc.getTime()) / 60000);
          const trueUtcEpoch = fakeUtc.getTime() - offsetMinutes * 60000;
          const trueDate = new Date(trueUtcEpoch);

          // Format target time in toTz
          const dtfTo = new Intl.DateTimeFormat("en-US", {
            timeZone: toTz,
            hour: "numeric",
            minute: "2-digit",
            hour12: true,
            timeZoneName: "short",
          });
          const toFormatted = dtfTo.format(trueDate);

          const dtfFromFormatted = new Intl.DateTimeFormat("en-US", {
            timeZone: fromTz,
            hour: "numeric",
            minute: "2-digit",
            hour12: true,
            timeZoneName: "short",
          });
          const fromFormatted = dtfFromFormatted.format(trueDate);

          const dtfDateTo = new Intl.DateTimeFormat("en-US", {
            timeZone: toTz,
            weekday: "short",
            month: "short",
            day: "numeric",
          });
          const toDateFormatted = dtfDateTo.format(trueDate);

          resultText.textContent = `${fromFormatted} (${fromName}) = ${toFormatted} (${toName})`;
          resultSub.textContent = `Target local date: ${toDateFormatted} in ${toName}. Instant precision calculated.`;
        }

        timeInput?.addEventListener("input", calculate);
        dateInput?.addEventListener("input", calculate);

        if (nowBtn) {
          nowBtn.addEventListener("click", () => {
            const now = new Date();
            const dtfNow = new Intl.DateTimeFormat("en-US", {
              timeZone: fromTz,
              hour: "2-digit",
              minute: "2-digit",
              hour12: false,
            });
            const parts = dtfNow.formatToParts(now);
            const getP = (t) => parts.find((p) => p.type === t)?.value || "00";
            const h = getP("hour");
            const m = getP("minute");
            if (timeInput) timeInput.value = `${h}:${m}`;
            calculate();
          });
        }

        calculate();
      })();
    </script>
  </body>
</html>
