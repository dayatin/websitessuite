---
import "@suite/ui-theme/base.css";
import { getAntiFOUCScript, renderHeaderHTML, renderFooterHTML } from "@suite/ui-theme";
import { renderMetaTags, buildWebApplicationSchema } from "@suite/seo-core";
import { renderAdSlotHTML, renderAffiliateCardHTML, renderConsentBannerHTML, getConsentModeScript } from "@suite/monetization";
import { WORLD_CITIES } from "../lib/time-engine.ts";

const siteTitle = "ChronoSpatial: World Clock, Precision Timezone Converter & Meeting Planner";
const canonicalUrl = Astro.site ? new URL("", Astro.site).href : "https://world-clock.suite.local/";
const description = "Real-time world clocks with visual time-of-day sky atmospheres, precision timezone converter, and 24-hour meeting overlap planner across global timezones.";

const metaHtml = renderMetaTags({
  title: siteTitle,
  description,
  canonicalUrl,
  siteName: "ChronoSpatial",
  type: "website",
});

const appSchema = buildWebApplicationSchema({
  name: "ChronoSpatial World Clock",
  url: canonicalUrl,
  description,
  applicationCategory: "UtilitiesApplication",
});

const adSlotTop = renderAdSlotHTML({
  client: "ca-pub-0000000000000000",
  slotId: "4001001001",
  format: "leaderboard",
  testMode: true,
});

const adSlotBottom = renderAdSlotHTML({
  client: "ca-pub-0000000000000000",
  slotId: "4001001002",
  format: "rectangle",
  testMode: true,
});

const affiliateOffer = renderAffiliateCardHTML({
  title: "Supercharge Global Remote Team Collaboration",
  description: "Seamless scheduling, automated timezone coordination, and async video messaging trusted by distributed engineering teams worldwide.",
  ctaText: "Explore Remote Tools",
  affiliateUrl: "https://partner.suite.local/remote-collaboration",
  merchantName: "Global Productivity Partner",
  badge: "Remote Work Recommended",
});

const defaultCityIds = ["london", "new-york", "san-francisco", "tokyo", "mumbai"];
const popularPills = [
  { id: "london", label: "London", flag: "🇬🇧" },
  { id: "new-york", label: "New York", flag: "🇺🇸" },
  { id: "tokyo", label: "Tokyo", flag: "🇯🇵" },
  { id: "san-francisco", label: "San Francisco", flag: "🇺🇸" },
  { id: "mumbai", label: "Mumbai", flag: "🇮🇳" },
  { id: "paris", label: "Paris", flag: "🇫🇷" },
  { id: "singapore", label: "Singapore", flag: "🇸🇬" },
  { id: "dubai", label: "Dubai", flag: "🇦🇪" },
  { id: "sydney", label: "Sydney", flag: "🇦🇺" },
  { id: "berlin", label: "Berlin", flag: "🇩🇪" },
  { id: "los-angeles", label: "Los Angeles", flag: "🇺🇸" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline set:html={getAntiFOUCScript()} />
    <Fragment set:html={getConsentModeScript()} />
    <Fragment set:html={metaHtml} />
    <script type="application/ld+json" is:inline set:html={appSchema} />
    <style>
      .app-tab-btn {
        padding: 12px 22px;
        font-weight: 600;
        font-size: 0.9375rem;
        border: none;
        border-bottom: 3px solid transparent;
        background: transparent;
        color: var(--text-secondary);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s ease;
      }
      .app-tab-btn:hover {
        color: var(--text-primary);
        background: var(--bg-surface-hover, rgba(255,255,255,0.03));
      }
      .app-tab-btn.is-active {
        color: var(--accent-primary);
        border-bottom-color: var(--accent-primary);
        font-weight: 700;
      }
      .world-clock-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 1.25rem;
        margin-bottom: 2rem;
      }
      .clock-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-md, 10px);
        overflow: hidden;
        position: relative;
        transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
        display: flex;
        flex-direction: column;
      }
      .clock-card:hover {
        border-color: var(--accent-primary);
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
      }
      .clock-card.is-base-city {
        border-color: var(--accent-primary);
        box-shadow: 0 0 0 2px var(--accent-primary);
      }
      .clock-card.highlight-pulse {
        animation: cardPulse 1.2s ease-in-out;
      }
      @keyframes cardPulse {
        0%, 100% { outline: none; }
        50% { outline: 3px solid #10b981; outline-offset: 2px; }
      }
      .sky-window {
        height: 64px;
        position: relative;
        padding: 8px 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        color: #ffffff;
        text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
        transition: background 0.8s ease;
      }
      .solar-track-bar {
        height: 4px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 9999px;
        position: relative;
        margin-top: 6px;
      }
      .solar-track-needle {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #ffffff;
        position: absolute;
        top: -3px;
        transform: translateX(-50%);
        box-shadow: 0 0 8px rgba(255, 255, 255, 0.9);
      }
      .analog-dial {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        border: 2px solid var(--border-subtle);
        background: var(--bg-surface);
        position: relative;
        flex-shrink: 0;
      }
      .analog-hand {
        position: absolute;
        bottom: 50%;
        left: 50%;
        transform-origin: bottom center;
        border-radius: 2px;
      }
      .analog-hour {
        width: 3px;
        height: 12px;
        background: var(--text-primary);
      }
      .analog-minute {
        width: 2px;
        height: 16px;
        background: var(--accent-primary);
      }
      .analog-center {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--text-primary);
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
      }
      .matrix-table-wrapper {
        overflow-x: auto;
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-md, 8px);
        background: var(--bg-surface);
      }
      .matrix-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.8125rem;
        min-width: 950px;
      }
      .matrix-table th, .matrix-table td {
        padding: 8px 4px;
        text-align: center;
        border-right: 1px solid var(--border-subtle);
        border-bottom: 1px solid var(--border-subtle);
      }
      .matrix-table th.city-col, .matrix-table td.city-col {
        position: sticky;
        left: 0;
        background: var(--bg-surface);
        z-index: 5;
        text-align: left;
        padding-left: 14px;
        min-width: 200px;
        font-weight: 600;
        box-shadow: 2px 0 6px rgba(0,0,0,0.15);
      }
      .matrix-cell {
        height: 34px;
        font-weight: 700;
        font-size: 0.75rem;
        cursor: pointer;
        user-select: none;
        transition: filter 0.1s ease, transform 0.1s ease;
      }
      .matrix-cell:hover {
        filter: brightness(1.3);
        transform: scale(1.05);
      }
      .matrix-cell.is-selected {
        outline: 2px solid var(--accent-primary);
        outline-offset: -2px;
        font-weight: 900;
        z-index: 2;
      }
      .hub-pill {
        font-size: 0.8125rem;
        padding: 5px 12px;
        border-radius: 9999px;
        border: 1px solid var(--border-subtle);
        background: var(--bg-surface);
        color: var(--text-secondary);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.15s ease;
      }
      .hub-pill:hover {
        border-color: var(--accent-primary);
        color: var(--text-primary);
        transform: translateY(-1px);
      }
      .preset-chip {
        padding: 4px 10px;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
        border: 1px solid var(--border-subtle);
        background: var(--bg-surface);
        color: var(--text-secondary);
        cursor: pointer;
        transition: all 0.15s ease;
      }
      .preset-chip:hover {
        border-color: var(--accent-primary);
        color: var(--text-primary);
      }
      .legend-dot {
        width: 10px;
        height: 10px;
        border-radius: 2px;
        display: inline-block;
      }
    </style>
  </head>
  <body>
    <Fragment set:html={renderHeaderHTML({
      siteTitle: "ChronoSpatial",
      navItems: [
        { label: "World Clock", href: "/#clocks" },
        { label: "Timezone Converter", href: "/#converter" },
        { label: "Meeting Planner", href: "/#matrix" },
        { label: "Schedule Sync", href: "/meet" },
        { label: "About", href: "/about" },
      ]
    })} />

    <main class="suite-container" style="flex: 1; padding-block: 2rem; max-width: 1200px;">
      <!-- Hero Header -->
      <section style="text-align: center; margin-bottom: 1.5rem;">
        <span class="suite-badge" style="margin-bottom: 8px;">🌐 Precision IANA Time & Solar Visuals</span>
        <h1 style="font-size: 2.25rem; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 8px;">
          ChronoSpatial World Clock & Timezone Suite
        </h1>
        <p style="font-size: 1rem; color: var(--text-secondary); max-width: 720px; margin-inline: auto;">
          Real-time world clocks with visual time-of-day skies, interactive instant timezone conversions, and an intelligent 24-hour meeting overlap matrix.
        </p>
      </section>

      <!-- Monetization: Top Leaderboard -->
      <div style="margin-bottom: 1.5rem;">
        <Fragment set:html={adSlotTop} />
      </div>

      <!-- Navigation Tabs -->
      <nav aria-label="Mode Switcher" style="display: flex; gap: 8px; border-bottom: 2px solid var(--border-subtle); margin-bottom: 1.5rem; overflow-x: auto;">
        <button id="tab-clocks-btn" type="button" class="app-tab-btn is-active" data-tab="clocks">
          <span>🕒 World Clock Grid</span>
        </button>
        <button id="tab-converter-btn" type="button" class="app-tab-btn" data-tab="converter">
          <span>🔄 Timezone Converter</span>
        </button>
        <button id="tab-matrix-btn" type="button" class="app-tab-btn" data-tab="matrix">
          <span>📅 Meeting Planner (24H Matrix)</span>
        </button>
      </nav>

      <!-- Global Controls & City Adder Bar -->
      <section class="suite-card" style="padding: 1.25rem; margin-bottom: 1.75rem;">
        <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap; justify-content: space-between; margin-bottom: 10px;">
          <!-- City Dropdown Adder -->
          <div style="display: flex; gap: 8px; flex: 1; min-width: 290px;">
            <select id="city-selector" class="suite-select" style="flex: 1; padding: 8px 12px; font-size: 0.875rem;">
              <option value="">➕ Select a city to add...</option>
              {WORLD_CITIES.map((c) => (
                <option value={c.id}>
                  {c.flag} {c.name}, {c.country} ({c.timezone})
                </option>
              ))}
            </select>
            <button id="add-city-btn" type="button" class="suite-btn-primary" style="padding: 8px 16px; font-size: 0.875rem;">
              Add City
            </button>
          </div>

          <!-- Format & Global Sync Controls -->
          <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
            <button id="format-toggle-btn" type="button" class="suite-btn-secondary" style="font-size: 0.8125rem; padding: 6px 12px;">
              ⏱️ Mode: 12H
            </button>
            <button id="reset-cities-btn" type="button" class="suite-btn-secondary" style="font-size: 0.8125rem; padding: 6px 12px;">
              🔄 Reset Cities
            </button>
            <button id="reset-time-btn" type="button" class="suite-btn-secondary" style="font-size: 0.8125rem; padding: 6px 12px;">
              ⚡ Live Sync
            </button>
          </div>
        </div>

        <!-- Quick Hub Pills -->
        <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
          <span style="font-size: 0.75rem; font-weight: 600; color: var(--text-muted);">Quick Add:</span>
          {popularPills.map((pill) => (
            <button type="button" class="hub-pill quick-add-pill" data-id={pill.id}>
              <span>{pill.flag}</span>
              <span>{pill.label}</span>
            </button>
          ))}
        </div>
      </section>

      <!-- TAB 1: World Clock Grid View with Sky Atmospheres -->
      <section id="panel-clocks" class="tab-panel">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 8px;">
          <div>
            <h2 style="font-size: 1.35rem; font-weight: 700; margin: 0;">Pinned World Clocks</h2>
            <p style="font-size: 0.8125rem; color: var(--text-secondary); margin-top: 2px;">
              Live visual skies, analog dials, and digital times across your cities. Click <strong>"Set as Reference"</strong> on any card to compare offsets.
            </p>
          </div>
          <span id="clocks-count-badge" class="suite-badge" style="font-size: 0.75rem;">
            5 Cities Pinned
          </span>
        </div>

        <div id="world-clocks-container" class="world-clock-grid">
          <!-- Dynamically populated via client script -->
        </div>
      </section>

      <!-- TAB 2: Precision Timezone Converter View -->
      <section id="panel-converter" class="tab-panel" style="display: none;">
        <div class="suite-card" style="padding: 1.75rem; margin-bottom: 2rem; border-top: 4px solid var(--accent-primary);">
          <div style="margin-bottom: 1.25rem;">
            <h2 style="font-size: 1.375rem; font-weight: 800; margin: 0 0 6px 0;">
              Interactive Timezone Converter
            </h2>
            <p style="font-size: 0.875rem; color: var(--text-secondary); margin: 0;">
              Pick an origin time and destination to calculate exact corresponding local times, date shifts, and working overlap hours.
            </p>
          </div>

          <!-- Interactive Input Form -->
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 1rem; margin-bottom: 1.25rem; background: var(--bg-surface-hover, rgba(255,255,255,0.02)); padding: 1.25rem; border-radius: var(--radius-sm, 6px); border: 1px solid var(--border-subtle);">
            <div>
              <label for="conv-date-input" style="display: block; font-size: 0.8125rem; font-weight: 600; margin-bottom: 6px; color: var(--text-secondary);">
                📅 Date
              </label>
              <input id="conv-date-input" type="date" class="suite-input" style="width: 100%; padding: 8px 12px; font-size: 0.875rem;" />
            </div>

            <div>
              <label for="conv-time-input" style="display: block; font-size: 0.8125rem; font-weight: 600; margin-bottom: 6px; color: var(--text-secondary);">
                ⏰ Origin Time
              </label>
              <input id="conv-time-input" type="time" class="suite-input" value="14:00" style="width: 100%; padding: 8px 12px; font-size: 0.875rem;" />
            </div>

            <div>
              <label for="conv-from-city" style="display: block; font-size: 0.8125rem; font-weight: 600; margin-bottom: 6px; color: var(--text-secondary);">
                📍 Origin Location
              </label>
              <select id="conv-from-city" class="suite-select" style="width: 100%; padding: 8px 12px; font-size: 0.875rem;">
                {WORLD_CITIES.map((c) => (
                  <option value={c.id}>
                    {c.flag} {c.name}, {c.country} ({c.timezone})
                  </option>
                ))}
              </select>
            </div>

            <div>
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                <label for="conv-to-city" style="font-size: 0.8125rem; font-weight: 600; color: var(--text-secondary);">
                  🎯 Target Location
                </label>
                <button id="conv-swap-btn" type="button" class="preset-chip" style="padding: 2px 8px; font-size: 0.6875rem;" title="Swap Origin and Target cities">
                  ⇄ Swap
                </button>
              </div>
              <select id="conv-to-city" class="suite-select" style="width: 100%; padding: 8px 12px; font-size: 0.875rem;">
                <option value="ALL">🌐 All Pinned Cities</option>
                {WORLD_CITIES.map((c) => (
                  <option value={c.id}>
                    {c.flag} {c.name}, {c.country}
                  </option>
                ))}
              </select>
            </div>
          </div>

          <!-- Time Presets Bar -->
          <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin-bottom: 1.5rem;">
            <span style="font-size: 0.75rem; font-weight: 600; color: var(--text-muted);">Quick Time:</span>
            <button type="button" class="preset-chip conv-preset-btn" data-time="now">⚡ Current Time</button>
            <button type="button" class="preset-chip conv-preset-btn" data-time="09:00">🌅 9:00 AM (Start of Work)</button>
            <button type="button" class="preset-chip conv-preset-btn" data-time="12:00">☀️ 12:00 PM (Noon)</button>
            <button type="button" class="preset-chip conv-preset-btn" data-time="15:00">☕ 3:00 PM (Afternoon)</button>
            <button type="button" class="preset-chip conv-preset-btn" data-time="18:00">🌇 6:00 PM (End of Work)</button>
          </div>

          <!-- Live Conversion Visual Hero Card -->
          <div id="conv-hero-banner" style="background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: var(--radius-md, 8px); padding: 1.5rem; margin-bottom: 1.75rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: 6px;">
              <span style="font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #10b981;">
                Instant Conversion
              </span>
              <span id="conv-diff-badge" class="suite-badge" style="font-size: 0.75rem;">
                Calculated
              </span>
            </div>
            <div id="conv-hero-text" style="font-size: 1.75rem; font-weight: 800; color: var(--text-primary); margin-bottom: 6px; line-height: 1.25;">
              <!-- Dynamically populated -->
            </div>
            <div id="conv-hero-sub" style="font-size: 0.9375rem; color: var(--text-secondary);">
              <!-- Dynamically populated -->
            </div>
          </div>

          <!-- Multi-City Converted Table -->
          <div style="margin-bottom: 1.5rem;">
            <h3 style="font-size: 1.0625rem; font-weight: 700; margin-bottom: 0.75rem;">
              Corresponding Times Across Pinned Cities
            </h3>
            <div style="overflow-x: auto; border: 1px solid var(--border-subtle); border-radius: var(--radius-sm, 6px);">
              <table style="width: 100%; border-collapse: collapse; font-size: 0.875rem;">
                <thead>
                  <tr style="background: var(--bg-surface-hover, rgba(255,255,255,0.03)); border-bottom: 1px solid var(--border-subtle); text-align: left;">
                    <th style="padding: 10px 14px; font-size: 0.75rem; color: var(--text-muted);">City</th>
                    <th style="padding: 10px 14px; font-size: 0.75rem; color: var(--text-muted);">Converted Time</th>
                    <th style="padding: 10px 14px; font-size: 0.75rem; color: var(--text-muted);">Local Date</th>
                    <th style="padding: 10px 14px; font-size: 0.75rem; color: var(--text-muted);">Time Difference</th>
                    <th style="padding: 10px 14px; font-size: 0.75rem; color: var(--text-muted);">Work Status</th>
                  </tr>
                </thead>
                <tbody id="conv-table-body">
                  <!-- Dynamically populated -->
                </tbody>
              </table>
            </div>
          </div>

          <!-- Action buttons: Copy & Share -->
          <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            <button id="conv-copy-btn" type="button" class="suite-btn-primary" style="padding: 8px 16px; font-size: 0.875rem;">
              📋 Copy Formatted Summary
            </button>
            <button id="conv-share-btn" type="button" class="suite-btn-secondary" style="padding: 8px 16px; font-size: 0.875rem;">
              🔗 Copy Shareable Link
            </button>
          </div>
        </div>
      </section>

      <!-- TAB 3: 24-Hour Meeting Overlap Matrix View -->
      <section id="panel-matrix" class="tab-panel" style="display: none;">
        <div class="suite-card" style="padding: 1.5rem; margin-bottom: 2rem; border-top: 4px solid var(--accent-primary);">
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 1rem;">
            <div>
              <h2 style="font-size: 1.25rem; font-weight: 700; margin: 0;">
                24-Hour Global Meeting Overlap Matrix
              </h2>
              <p style="font-size: 0.8125rem; color: var(--text-secondary); margin-top: 2px;">
                Click any hour column or drag the slider to preview working overlaps across all locations.
              </p>
            </div>

            <!-- Golden Window Action -->
            <button id="jump-golden-btn" type="button" class="suite-btn-primary" style="font-size: 0.8125rem; padding: 6px 14px; background: #10b981; border-color: #10b981;">
              ✨ Jump to Best Overlap
            </button>
          </div>

          <!-- Overlap Status Banner -->
          <div id="overlap-banner" style="background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: var(--radius-sm, 6px); padding: 10px 14px; margin-bottom: 1.25rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
            <div style="display: flex; align-items: center; gap: 8px;">
              <span id="fitness-badge" style="font-size: 0.75rem; font-weight: 700; padding: 2px 8px; border-radius: 9999px; background: #10b981; color: white;">
                GOLDEN OVERLAP
              </span>
              <span id="fitness-label" style="font-size: 0.875rem; font-weight: 500; color: var(--text-primary);">
                Selected UTC 14:00 — Standard business hours across all selected locations.
              </span>
            </div>
            <span id="fitness-utc-display" style="font-size: 0.8125rem; font-weight: 700; font-family: monospace; color: var(--text-secondary);">
              UTC 14:00
            </span>
          </div>

          <!-- Synchronized Master Range Slider -->
          <div style="margin-bottom: 1.25rem;">
            <div style="display: flex; justify-content: space-between; font-size: 0.75rem; font-family: monospace; color: var(--text-muted); margin-bottom: 4px;">
              <span>00:00 UTC</span>
              <span>04:00</span>
              <span>08:00</span>
              <span>12:00 (Noon)</span>
              <span>16:00</span>
              <span>20:00</span>
              <span>23:00 UTC</span>
            </div>
            <input
              id="scrubber-slider"
              type="range"
              min="0"
              max="23"
              step="1"
              value="14"
              style="width: 100%; cursor: ew-resize; accent-color: var(--accent-primary);"
            />
          </div>

          <!-- Unified Multi-City 24H Matrix Table -->
          <div class="matrix-table-wrapper" style="margin-bottom: 1.25rem;">
            <table class="matrix-table">
              <thead>
                <tr style="background: var(--bg-surface-hover, rgba(255,255,255,0.03));">
                  <th class="city-col">Location / City</th>
                  {Array.from({ length: 24 }).map((_, i) => (
                    <th style="min-width: 38px; font-size: 0.6875rem; font-family: monospace; color: var(--text-muted);">
                      {i.toString().padStart(2, "0")}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody id="matrix-table-body">
                <!-- Dynamically populated via client script -->
              </tbody>
            </table>
          </div>

          <!-- Legend & Calendar Export -->
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; border-top: 1px solid var(--border-subtle); padding-top: 12px;">
            <div style="display: flex; gap: 16px; flex-wrap: wrap; align-items: center;">
              <span style="font-size: 0.75rem; font-weight: 600; color: var(--text-muted);">Hours Legend:</span>
              <span style="font-size: 0.75rem; color: var(--text-secondary); display: inline-flex; align-items: center; gap: 6px;">
                <span class="legend-dot" style="background: rgba(16, 185, 129, 0.7);"></span> Work (9am - 6pm)
              </span>
              <span style="font-size: 0.75rem; color: var(--text-secondary); display: inline-flex; align-items: center; gap: 6px;">
                <span class="legend-dot" style="background: rgba(245, 158, 11, 0.7);"></span> Awake (8-9am, 6-10pm)
              </span>
              <span style="font-size: 0.75rem; color: var(--text-secondary); display: inline-flex; align-items: center; gap: 6px;">
                <span class="legend-dot" style="background: rgba(100, 116, 139, 0.4);"></span> Sleep / Off-hours
              </span>
            </div>

            <a
              id="plan-meeting-link"
              href="/meet"
              class="suite-btn-primary"
              style="font-size: 0.8125rem; padding: 6px 14px; text-decoration: none;"
            >
              📅 Schedule Meeting at This Hour
            </a>
          </div>
        </div>
      </section>

      <!-- Contextual Affiliate Offer -->
      <Fragment set:html={affiliateOffer} />

      <!-- Monetization: Bottom Rectangle -->
      <section style="margin-top: 2rem;">
        <Fragment set:html={adSlotBottom} />
      </section>
    </main>

    <Fragment set:html={renderFooterHTML({
      authorName: "ChronoSpatial Team",
      currentYear: 2026,
      privacyUrl: "/privacy-policy",
      termsUrl: "/terms-of-service",
      editorialUrl: "/editorial-policy",
      contactUrl: "/contact",
    })} />
    <Fragment set:html={renderConsentBannerHTML()} />

    <!-- Client-Side Real-Time Engine Script -->
    <script is:inline define:vars={{ WORLD_CITIES, defaultCityIds }}>
      (() => {
        let pinnedCityIds = JSON.parse(localStorage.getItem("cs_cities") || JSON.stringify(defaultCityIds));
        let baseCityId = localStorage.getItem("cs_base_city") || "london";
        let is24Hour = localStorage.getItem("cs_format") === "24";
        let isLive = true;
        let scrubbedUtcHour = new Date().getUTCHours();
        let activeTab = "clocks";

        const citiesMap = new Map(WORLD_CITIES.map((c) => [c.id, c]));

        if (!citiesMap.has(baseCityId)) {
          baseCityId = pinnedCityIds[0] || "london";
        }

        // DOM elements
        const tabClocksBtn = document.getElementById("tab-clocks-btn");
        const tabConverterBtn = document.getElementById("tab-converter-btn");
        const tabMatrixBtn = document.getElementById("tab-matrix-btn");
        const panelClocks = document.getElementById("panel-clocks");
        const panelConverter = document.getElementById("panel-converter");
        const panelMatrix = document.getElementById("panel-matrix");

        const worldClocksContainer = document.getElementById("world-clocks-container");
        const clocksCountBadge = document.getElementById("clocks-count-badge");
        const citySelector = document.getElementById("city-selector");
        const addCityBtn = document.getElementById("add-city-btn");
        const formatToggleBtn = document.getElementById("format-toggle-btn");
        const resetCitiesBtn = document.getElementById("reset-cities-btn");
        const resetTimeBtn = document.getElementById("reset-time-btn");

        // Matrix elements
        const scrubberSlider = document.getElementById("scrubber-slider");
        const jumpGoldenBtn = document.getElementById("jump-golden-btn");
        const fitnessBadge = document.getElementById("fitness-badge");
        const fitnessLabel = document.getElementById("fitness-label");
        const fitnessUtcDisplay = document.getElementById("fitness-utc-display");
        const overlapBanner = document.getElementById("overlap-banner");
        const matrixTableBody = document.getElementById("matrix-table-body");
        const planMeetingLink = document.getElementById("plan-meeting-link");

        // Converter elements
        const convDateInput = document.getElementById("conv-date-input");
        const convTimeInput = document.getElementById("conv-time-input");
        const convFromCity = document.getElementById("conv-from-city");
        const convToCity = document.getElementById("conv-to-city");
        const convSwapBtn = document.getElementById("conv-swap-btn");
        const convHeroText = document.getElementById("conv-hero-text");
        const convHeroSub = document.getElementById("conv-hero-sub");
        const convDiffBadge = document.getElementById("conv-diff-badge");
        const convTableBody = document.getElementById("conv-table-body");
        const convCopyBtn = document.getElementById("conv-copy-btn");
        const convShareBtn = document.getElementById("conv-share-btn");

        // Set default date & target city
        if (convDateInput) {
          convDateInput.value = new Date().toISOString().split("T")[0];
        }
        if (convToCity && convToCity.value === "ALL" && pinnedCityIds.length > 1) {
          convToCity.value = pinnedCityIds[1] || "london";
        }

        function saveState() {
          localStorage.setItem("cs_cities", JSON.stringify(pinnedCityIds));
          localStorage.setItem("cs_base_city", baseCityId);
          localStorage.setItem("cs_format", is24Hour ? "24" : "12");
        }

        function getCityTimeInfo(date, timezone) {
          const dtf = new Intl.DateTimeFormat("en-US", {
            timeZone: timezone,
            year: "numeric",
            month: "2-digit",
            day: "2-digit",
            hour: "2-digit",
            minute: "2-digit",
            second: "2-digit",
            hour12: false,
            timeZoneName: "short",
          });
          const parts = dtf.formatToParts(date);
          const getP = (t) => parts.find((p) => p.type === t)?.value || "0";
          const y = Number.parseInt(getP("year"), 10);
          const mo = Number.parseInt(getP("month"), 10);
          const d = Number.parseInt(getP("day"), 10);
          const h = Number.parseInt(getP("hour"), 10) % 24;
          const m = Number.parseInt(getP("minute"), 10);
          const s = Number.parseInt(getP("second"), 10);
          const abbr = getP("timeZoneName");

          const dtfDate = new Intl.DateTimeFormat("en-US", {
            timeZone: timezone,
            weekday: "short",
            month: "short",
            day: "numeric",
          });
          const formattedDate = dtfDate.format(date);

          const period = h >= 12 ? "PM" : "AM";
          const h12 = h % 12 || 12;
          const formattedTime12 = `${h12.toString().padStart(2, "0")}:${m.toString().padStart(2, "0")}:${s.toString().padStart(2, "0")} ${period}`;
          const formattedTime24 = `${h.toString().padStart(2, "0")}:${m.toString().padStart(2, "0")}:${s.toString().padStart(2, "0")}`;

          // Offset in minutes
          const localDateAsUtc = new Date(Date.UTC(y, mo - 1, d, h, m, s));
          const utcOffsetMinutes = Math.round((localDateAsUtc.getTime() - date.getTime()) / 60000);
          const sign = utcOffsetMinutes >= 0 ? "+" : "-";
          const absM = Math.abs(utcOffsetMinutes);
          const offH = Math.floor(absM / 60).toString().padStart(2, "0");
          const offM = (absM % 60).toString().padStart(2, "0");
          const formattedUtcOffset = `UTC${sign}${offH}:${offM}`;

          return {
            hours: h,
            minutes: m,
            seconds: s,
            formattedTime12,
            formattedTime24,
            formattedDate,
            abbr,
            utcOffsetMinutes,
            formattedUtcOffset,
          };
        }

        function classifyHour(h) {
          if (h >= 9 && h < 18) return "work";
          if ((h >= 8 && h < 9) || (h >= 18 && h < 22)) return "awake";
          return "sleep";
        }

        function getStatusColor(status) {
          if (status === "work") return { bg: "rgba(16, 185, 129, 0.25)", fg: "#10b981", label: "Work Hours (9-18)" };
          if (status === "awake") return { bg: "rgba(245, 158, 11, 0.2)", fg: "#f59e0b", label: "Awake (8-9, 18-22)" };
          return { bg: "rgba(100, 116, 139, 0.15)", fg: "#94a3b8", label: "Sleep (22-8)" };
        }

        /**
         * Returns atmospheric visual sky data (colors, icon, label, celestial position)
         */
        function getSkyAtmosphere(h, m) {
          const frac = h + m / 60;
          const progressPercent = Math.min(100, Math.max(0, (frac / 24) * 100));

          if (frac >= 22.5 || frac < 4.5) {
            return {
              bg: "linear-gradient(135deg, #070b19 0%, #11172e 60%, #1b2446 100%)",
              icon: "🌙",
              label: "Deep Night",
              atmosphere: "Starry Night • Rest Period",
              progressPercent,
              isDay: false,
            };
          }
          if (frac >= 4.5 && frac < 7.0) {
            return {
              bg: "linear-gradient(135deg, #2c1654 0%, #6d214f 35%, #b33939 65%, #f39c12 100%)",
              icon: "🌅",
              label: "Dawn & Sunrise",
              atmosphere: "Morning Twilight • Sun Rising",
              progressPercent,
              isDay: true,
            };
          }
          if (frac >= 7.0 && frac < 11.0) {
            return {
              bg: "linear-gradient(135deg, #1b62a5 0%, #3498db 50%, #74b9ff 100%)",
              icon: "🌤️",
              label: "Morning Daylight",
              atmosphere: "Fresh Morning • Active Hours",
              progressPercent,
              isDay: true,
            };
          }
          if (frac >= 11.0 && frac < 16.0) {
            return {
              bg: "linear-gradient(135deg, #0984e3 0%, #00cec9 100%)",
              icon: "☀️",
              label: "Midday Sun",
              atmosphere: "Peak Sun • Zenith Daylight",
              progressPercent,
              isDay: true,
            };
          }
          if (frac >= 16.0 && frac < 18.5) {
            return {
              bg: "linear-gradient(135deg, #d35400 0%, #e67e22 45%, #f1c40f 100%)",
              icon: "🌤️",
              label: "Golden Hour",
              atmosphere: "Warm Afternoon Glow",
              progressPercent,
              isDay: true,
            };
          }
          if (frac >= 18.5 && frac < 20.5) {
            return {
              bg: "linear-gradient(135deg, #1e0034 0%, #8e44ad 40%, #e74c3c 75%, #f39c12 100%)",
              icon: "🌆",
              label: "Sunset Twilight",
              atmosphere: "Dusk • Sun Below Horizon",
              progressPercent,
              isDay: false,
            };
          }
          return {
            bg: "linear-gradient(135deg, #0b132b 0%, #1c2541 60%, #3a506b 100%)",
            icon: "🌃",
            label: "Evening Dusk",
            atmosphere: "Nightfall • Evening Leisure",
            progressPercent,
            isDay: false,
          };
        }

        function switchTab(tab) {
          activeTab = tab;
          tabClocksBtn?.classList.toggle("is-active", tab === "clocks");
          tabConverterBtn?.classList.toggle("is-active", tab === "converter");
          tabMatrixBtn?.classList.toggle("is-active", tab === "matrix");

          if (panelClocks) panelClocks.style.display = tab === "clocks" ? "block" : "none";
          if (panelConverter) panelConverter.style.display = tab === "converter" ? "block" : "none";
          if (panelMatrix) panelMatrix.style.display = tab === "matrix" ? "block" : "none";

          if (tab === "clocks") renderWorldClocks();
          else if (tab === "converter") renderConverter();
          else if (tab === "matrix") {
            renderMatrix();
            updateOverlapFitness();
          }
        }

        // ==========================================
        // TAB 1: WORLD CLOCK GRID RENDERING
        // ==========================================
        function renderWorldClocks() {
          if (!worldClocksContainer) return;
          worldClocksContainer.innerHTML = "";

          const now = new Date();
          const targetDate = isLive
            ? now
            : new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate(), scrubbedUtcHour, 0, 0));

          const baseCity = citiesMap.get(baseCityId) || citiesMap.get(pinnedCityIds[0]) || WORLD_CITIES[0];
          const baseInfo = getCityTimeInfo(targetDate, baseCity.timezone);

          if (clocksCountBadge) {
            clocksCountBadge.textContent = `${pinnedCityIds.length} ${pinnedCityIds.length === 1 ? "City" : "Cities"} Pinned`;
          }

          pinnedCityIds.forEach((id) => {
            const city = citiesMap.get(id);
            if (!city) return;

            const info = getCityTimeInfo(targetDate, city.timezone);
            const status = classifyHour(info.hours);
            const statusStyle = getStatusColor(status);
            const sky = getSkyAtmosphere(info.hours, info.minutes);
            const isBase = city.id === baseCity.id;

            // Diff calculation
            const diffMinutes = info.utcOffsetMinutes - baseInfo.utcOffsetMinutes;
            const diffHours = diffMinutes / 60;
            let diffLabel = "";
            if (isBase) {
              diffLabel = "📍 Reference City";
            } else if (diffMinutes === 0) {
              diffLabel = "Same time as Reference";
            } else {
              const sign = diffHours > 0 ? "+" : "";
              const hrsFormatted = Number.isInteger(diffHours) ? diffHours : diffHours.toFixed(1);
              diffLabel = `${sign}${hrsFormatted} hrs vs ${baseCity.name}`;
            }

            // Analog angles
            const hourAngle = ((info.hours % 12) + info.minutes / 60) * 30;
            const minuteAngle = (info.minutes + info.seconds / 60) * 6;

            const card = document.createElement("article");
            card.className = `clock-card ${isBase ? "is-base-city" : ""}`;
            card.id = `clock-card-${city.id}`;

            card.innerHTML = `
              <!-- Visual Sky Atmosphere Window -->
              <div class="sky-window" style="background: ${sky.bg};">
                <div style="display: flex; align-items: center; gap: 8px;">
                  <span style="font-size: 1.75rem;">${sky.icon}</span>
                  <div>
                    <div style="font-weight: 800; font-size: 0.875rem; letter-spacing: -0.01em;">${sky.label}</div>
                    <div style="font-size: 0.6875rem; opacity: 0.9;">${sky.atmosphere}</div>
                  </div>
                </div>
                <div style="text-align: right;">
                  <span style="font-size: 0.75rem; font-weight: 700; background: rgba(0,0,0,0.3); padding: 2px 6px; border-radius: 4px;">
                    ${city.flag} ${city.name}
                  </span>
                </div>
              </div>

              <!-- Solar 24H Daylight Arc Tracker -->
              <div style="padding: 0 14px; background: rgba(0,0,0,0.1);">
                <div class="solar-track-bar" title="Solar 24H Cycle: ${sky.progressPercent.toFixed(0)}% through the day">
                  <div class="solar-track-needle" style="left: ${sky.progressPercent}%;"></div>
                </div>
                <div style="display: flex; justify-content: space-between; font-size: 0.625rem; color: var(--text-muted); padding-block: 4px;">
                  <span>00:00 (Night)</span>
                  <span>06:00 (Dawn)</span>
                  <span>12:00 (Noon)</span>
                  <span>18:00 (Sunset)</span>
                  <span>24:00</span>
                </div>
              </div>

              <!-- Card Body -->
              <div style="padding: 1.25rem; flex: 1; display: flex; flex-direction: column; justify-content: space-between;">
                <div>
                  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10px;">
                    <div>
                      <div style="display: flex; align-items: center; gap: 6px;">
                        <h3 style="font-size: 1.25rem; font-weight: 700; margin: 0;">${city.name}</h3>
                        <span style="font-size: 0.8125rem; color: var(--text-muted);">${city.country}</span>
                      </div>
                      <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 2px;">
                        ${info.abbr} &bull; ${info.formattedUtcOffset}
                      </div>
                    </div>
                    <button class="suite-btn-secondary remove-city-btn" data-id="${city.id}" style="font-size: 0.6875rem; padding: 2px 8px;" title="Remove ${city.name}">
                      ✕
                    </button>
                  </div>

                  <!-- Center Visual Time Display (Analog Dial + Digital Time) -->
                  <div style="display: flex; align-items: center; gap: 14px; margin-block: 10px;">
                    <div class="analog-dial" title="Analog position for ${city.name}">
                      <div class="analog-hand analog-hour" style="transform: rotate(${hourAngle}deg);"></div>
                      <div class="analog-hand analog-minute" style="transform: rotate(${minuteAngle}deg);"></div>
                      <div class="analog-center"></div>
                    </div>
                    <div>
                      <div class="clock-digital-time" style="font-size: 1.875rem; font-weight: 800; font-family: monospace; letter-spacing: -0.02em; color: var(--text-primary); line-height: 1;">
                        ${is24Hour ? info.formattedTime24 : info.formattedTime12}
                      </div>
                      <div class="clock-date-str" style="font-size: 0.8125rem; color: var(--text-secondary); margin-top: 4px;">
                        📅 ${info.formattedDate}
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Footer Badges and Actions -->
                <div>
                  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 6px; padding-top: 10px; border-top: 1px solid var(--border-subtle); font-size: 0.75rem;">
                    <span style="color: ${statusStyle.fg}; font-weight: 700;">
                      ● ${statusStyle.label}
                    </span>
                    <span class="suite-badge" style="font-size: 0.6875rem;">
                      ${diffLabel}
                    </span>
                  </div>

                  <div style="display: flex; justify-content: flex-end; align-items: center; margin-top: 10px;">
                    ${
                      isBase
                        ? '<span style="color: var(--accent-primary); font-weight: 700; font-size: 0.75rem;">★ Active Reference</span>'
                        : `<button class="set-base-btn suite-btn-secondary" data-id="${city.id}" style="font-size: 0.6875rem; padding: 4px 10px;">Set as Reference</button>`
                    }
                  </div>
                </div>
              </div>
            `;

            worldClocksContainer.appendChild(card);
          });

          // Attach listeners to newly rendered cards
          worldClocksContainer.querySelectorAll(".remove-city-btn").forEach((btn) => {
            btn.addEventListener("click", (e) => {
              const id = e.currentTarget.getAttribute("data-id");
              pinnedCityIds = pinnedCityIds.filter((cid) => cid !== id);
              if (baseCityId === id) {
                baseCityId = pinnedCityIds[0] || "london";
              }
              saveState();
              renderAll();
            });
          });

          worldClocksContainer.querySelectorAll(".set-base-btn").forEach((btn) => {
            btn.addEventListener("click", (e) => {
              baseCityId = e.currentTarget.getAttribute("data-id");
              saveState();
              renderAll();
            });
          });
        }

        /**
         * Smooth 1-second in-place update WITHOUT wiping innerHTML or destroying DOM listeners
         */
        function updateClockTimesInPlace() {
          if (!worldClocksContainer || activeTab !== "clocks") return;

          const now = new Date();
          const targetDate = isLive
            ? now
            : new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate(), scrubbedUtcHour, 0, 0));

          pinnedCityIds.forEach((id) => {
            const city = citiesMap.get(id);
            if (!city) return;

            const card = document.getElementById(`clock-card-${city.id}`);
            if (!card) return;

            const info = getCityTimeInfo(targetDate, city.timezone);
            const digitalEl = card.querySelector(".clock-digital-time");
            const dateEl = card.querySelector(".clock-date-str");

            if (digitalEl) {
              digitalEl.textContent = is24Hour ? info.formattedTime24 : info.formattedTime12;
            }
            if (dateEl) {
              dateEl.textContent = `📅 ${info.formattedDate}`;
            }

            // Update analog dial
            const hourHand = card.querySelector(".analog-hour");
            const minuteHand = card.querySelector(".analog-minute");
            if (hourHand && minuteHand) {
              const hourAngle = ((info.hours % 12) + info.minutes / 60) * 30;
              const minuteAngle = (info.minutes + info.seconds / 60) * 6;
              hourHand.style.transform = `rotate(${hourAngle}deg)`;
              minuteHand.style.transform = `rotate(${minuteAngle}deg)`;
            }
          });
        }

        // ==========================================
        // TAB 2: TIMEZONE CONVERTER LOGIC
        // ==========================================
        function renderConverter() {
          if (!convDateInput || !convTimeInput || !convFromCity || !convToCity) return;

          const dateVal = convDateInput.value || new Date().toISOString().split("T")[0];
          const timeVal = convTimeInput.value || "14:00";
          const [hoursStr, minsStr] = timeVal.split(":");
          const parsedHours = Number.parseInt(hoursStr || "14", 10);
          const parsedMins = Number.parseInt(minsStr || "0", 10);

          const fromCity = citiesMap.get(convFromCity.value) || citiesMap.get("new-york") || WORLD_CITIES[0];
          let toCityId = convToCity.value;

          // If toCityId is fromCity, pick another sensible city
          if (toCityId === fromCity.id) {
            toCityId = pinnedCityIds.find((cid) => cid !== fromCity.id) || "london";
            convToCity.value = toCityId;
          }

          // Compute absolute origin date in fromCity timezone
          const [y, mo, d] = dateVal.split("-").map((v) => Number.parseInt(v, 10));
          const fakeUtc = new Date(Date.UTC(y, mo - 1, d, parsedHours, parsedMins, 0));
          const probeInfo = getCityTimeInfo(fakeUtc, fromCity.timezone);
          const originUtcEpoch = fakeUtc.getTime() - probeInfo.utcOffsetMinutes * 60000;
          const originDate = new Date(originUtcEpoch);

          const fromInfo = getCityTimeInfo(originDate, fromCity.timezone);
          const fTime = is24Hour ? fromInfo.formattedTime24 : fromInfo.formattedTime12;

          if (toCityId !== "ALL" && citiesMap.has(toCityId)) {
            const targetCity = citiesMap.get(toCityId);
            const targetInfo = getCityTimeInfo(originDate, targetCity.timezone);
            const diffMin = targetInfo.utcOffsetMinutes - fromInfo.utcOffsetMinutes;
            const diffHours = diffMin / 60;
            const sign = diffHours >= 0 ? "+" : "";
            const diffStr = diffMin === 0 ? "same time" : `${sign}${diffHours} hrs`;
            const tTime = is24Hour ? targetInfo.formattedTime24 : targetInfo.formattedTime12;

            if (convHeroText) {
              convHeroText.innerHTML = `
                <span>${fTime}</span> in <strong style="color: var(--accent-primary);">${fromCity.flag} ${fromCity.name}</strong>
                <span style="margin-inline: 8px; color: var(--text-muted);">&rarr;</span>
                <span>${tTime}</span> in <strong style="color: #10b981;">${targetCity.flag} ${targetCity.name}</strong>
              `;
            }
            if (convHeroSub) {
              convHeroSub.textContent = `${targetCity.name} is ${diffStr} relative to ${fromCity.name}. Origin date: ${fromInfo.formattedDate} ➔ Destination date: ${targetInfo.formattedDate}.`;
            }
            if (convDiffBadge) {
              convDiffBadge.textContent = diffMin === 0 ? "Simultaneous" : `${sign}${diffHours} Hours Shift`;
            }
          } else {
            if (convHeroText) {
              convHeroText.innerHTML = `<span>${fTime}</span> in <strong style="color: var(--accent-primary);">${fromCity.flag} ${fromCity.name}</strong> (${fromInfo.abbr})`;
            }
            if (convHeroSub) {
              convHeroSub.textContent = `Displaying synchronized local times across all ${pinnedCityIds.length} pinned locations for ${fromInfo.formattedDate}.`;
            }
            if (convDiffBadge) {
              convDiffBadge.textContent = "All Cities Overview";
            }
          }

          // Render multi-city conversion table
          if (convTableBody) {
            convTableBody.innerHTML = "";
            pinnedCityIds.forEach((id) => {
              const city = citiesMap.get(id);
              if (!city) return;

              const cInfo = getCityTimeInfo(originDate, city.timezone);
              const cStatus = classifyHour(cInfo.hours);
              const cStyle = getStatusColor(cStatus);

              const diffMin = cInfo.utcOffsetMinutes - fromInfo.utcOffsetMinutes;
              const diffHours = diffMin / 60;
              const sign = diffHours > 0 ? "+" : "";
              const diffLabel =
                city.id === fromCity.id
                  ? "📍 Origin Location"
                  : diffMin === 0
                    ? "Same time"
                    : `${sign}${diffHours} hrs vs Origin`;

              const row = document.createElement("tr");
              row.style.borderBottom = "1px solid var(--border-subtle)";
              if (city.id === fromCity.id) {
                row.style.background = "rgba(16, 185, 129, 0.08)";
              } else if (city.id === toCityId) {
                row.style.background = "rgba(99, 102, 241, 0.08)";
              }

              row.innerHTML = `
                <td style="padding: 10px 14px; font-weight: 600;">
                  ${city.flag} ${city.name}
                  <span style="font-size: 0.75rem; color: var(--text-muted); margin-left: 4px;">(${cInfo.abbr})</span>
                </td>
                <td style="padding: 10px 14px; font-weight: 700; font-family: monospace; font-size: 1.0625rem;">
                  ${is24Hour ? cInfo.formattedTime24 : cInfo.formattedTime12}
                </td>
                <td style="padding: 10px 14px; color: var(--text-secondary);">
                  ${cInfo.formattedDate}
                </td>
                <td style="padding: 10px 14px;">
                  <span class="suite-badge" style="font-size: 0.75rem;">${diffLabel}</span>
                </td>
                <td style="padding: 10px 14px;">
                  <span style="color: ${cStyle.fg}; font-weight: 700; font-size: 0.75rem;">
                    ● ${cStyle.label}
                  </span>
                </td>
              `;
              convTableBody.appendChild(row);
            });
          }
        }

        // ==========================================
        // TAB 3: 24-HOUR OVERLAP MATRIX RENDERING
        // ==========================================
        function renderMatrix() {
          if (!matrixTableBody) return;
          matrixTableBody.innerHTML = "";

          const now = new Date();
          const targetBaseDate = isLive
            ? now
            : new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate(), scrubbedUtcHour, 0, 0));

          pinnedCityIds.forEach((id) => {
            const city = citiesMap.get(id);
            if (!city) return;

            const currentInfo = getCityTimeInfo(targetBaseDate, city.timezone);
            const row = document.createElement("tr");

            let cellsHtml = "";
            for (let hUtc = 0; hUtc < 24; hUtc++) {
              const slotUtc = new Date(
                Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate(), hUtc, 0, 0),
              );
              const slotInfo = getCityTimeInfo(slotUtc, city.timezone);
              const slotStatus = classifyHour(slotInfo.hours);
              const slotStyle = getStatusColor(slotStatus);
              const isSelected = hUtc === scrubbedUtcHour;

              const hourDisplay = is24Hour
                ? slotInfo.hours.toString().padStart(2, "0")
                : (slotInfo.hours % 12 || 12).toString();

              cellsHtml += `
                <td
                  class="matrix-cell ${isSelected ? "is-selected" : ""}"
                  style="background: ${slotStyle.bg}; color: ${slotStyle.fg};"
                  title="UTC ${hUtc}:00 &bull; ${city.name}: ${slotInfo.hours}:00 (${slotStatus})"
                  data-utc="${hUtc}"
                >
                  ${hourDisplay}
                </td>
              `;
            }

            row.innerHTML = `
              <td class="city-col">
                <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px;">
                  <div>
                    <span>${city.flag} ${city.name}</span>
                    <div style="font-size: 0.6875rem; color: var(--text-muted); font-weight: normal;">
                      ${currentInfo.abbr} (${currentInfo.formattedUtcOffset})
                    </div>
                  </div>
                  <div style="font-family: monospace; font-size: 0.8125rem; font-weight: 700; color: var(--text-primary);">
                    ${is24Hour ? currentInfo.formattedTime24.slice(0, 5) : currentInfo.formattedTime12.slice(0, 5) + " " + (currentInfo.hours >= 12 ? "PM" : "AM")}
                  </div>
                </div>
              </td>
              ${cellsHtml}
            `;

            matrixTableBody.appendChild(row);
          });

          // Add click listeners to matrix cells
          matrixTableBody.querySelectorAll(".matrix-cell").forEach((cell) => {
            cell.addEventListener("click", (e) => {
              const utc = Number.parseInt(e.currentTarget.getAttribute("data-utc"), 10);
              setScrubbedHour(utc);
            });
          });

          // Update meeting planner href with fully compliant schema parameters
          if (planMeetingLink) {
            const meetingDate = new Date(
              Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate(), scrubbedUtcHour, 0, 0),
            );
            const params = new URLSearchParams();
            params.set("host", pinnedCityIds[0] || "london");
            params.set("cities", pinnedCityIds.join(","));
            params.set("start", meetingDate.toISOString());
            params.set("title", "Global Team Sync");
            planMeetingLink.href = `/meet?${params.toString()}`;
          }
        }

        function setScrubbedHour(utc) {
          isLive = false;
          scrubbedUtcHour = utc;
          if (scrubberSlider) scrubberSlider.value = utc;
          if (resetTimeBtn) resetTimeBtn.style.outline = "2px solid var(--accent-primary)";
          renderMatrix();
          updateOverlapFitness();
          if (activeTab === "clocks") renderWorldClocks();
        }

        function updateOverlapFitness() {
          if (!fitnessBadge || !fitnessLabel || !fitnessUtcDisplay || !overlapBanner) return;

          const now = new Date();
          const targetDate = new Date(
            Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate(), scrubbedUtcHour, 0, 0),
          );

          let workCount = 0;
          let sleepCount = 0;
          const total = pinnedCityIds.length;

          pinnedCityIds.forEach((id) => {
            const city = citiesMap.get(id);
            if (!city) return;
            const timeInfo = getCityTimeInfo(targetDate, city.timezone);
            const status = classifyHour(timeInfo.hours);
            if (status === "work") workCount++;
            if (status === "sleep") sleepCount++;
          });

          fitnessUtcDisplay.textContent = `UTC ${scrubbedUtcHour.toString().padStart(2, "0")}:00`;

          if (sleepCount === 0 && workCount === total) {
            fitnessBadge.textContent = "✨ GOLDEN OVERLAP";
            fitnessBadge.style.background = "#10b981";
            fitnessLabel.textContent = "Prime working hours (9am-6pm) for all selected locations!";
            overlapBanner.style.background = "rgba(16, 185, 129, 0.15)";
            overlapBanner.style.borderColor = "rgba(16, 185, 129, 0.4)";
          } else if (sleepCount === 0) {
            fitnessBadge.textContent = "👍 ACCEPTABLE";
            fitnessBadge.style.background = "#f59e0b";
            fitnessLabel.textContent = "All participants are awake (8am-10pm). Suitable for scheduled meetings.";
            overlapBanner.style.background = "rgba(245, 158, 11, 0.15)";
            overlapBanner.style.borderColor = "rgba(245, 158, 11, 0.4)";
          } else {
            fitnessBadge.textContent = "⚠️ ASLEEP";
            fitnessBadge.style.background = "#ef4444";
            fitnessLabel.textContent = `${sleepCount} of ${total} locations are in sleep hours (10pm-8am).`;
            overlapBanner.style.background = "rgba(239, 68, 68, 0.12)";
            overlapBanner.style.borderColor = "rgba(239, 68, 68, 0.3)";
          }
        }

        function findBestOverlapHour() {
          const now = new Date();
          let bestHour = 14;
          let highestScore = -999;

          for (let h = 0; h < 24; h++) {
            const targetDate = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate(), h, 0, 0));
            let score = 0;
            pinnedCityIds.forEach((id) => {
              const city = citiesMap.get(id);
              if (!city) return;
              const info = getCityTimeInfo(targetDate, city.timezone);
              const status = classifyHour(info.hours);
              if (status === "work") score += 3;
              else if (status === "awake") score += 1;
              else score -= 4;
            });
            if (score > highestScore) {
              highestScore = score;
              bestHour = h;
            }
          }
          return bestHour;
        }

        function renderAll() {
          renderWorldClocks();
          renderConverter();
          renderMatrix();
          updateOverlapFitness();
        }

        // ==========================================
        // EVENT HANDLERS & LISTENERS
        // ==========================================
        tabClocksBtn?.addEventListener("click", () => switchTab("clocks"));
        tabConverterBtn?.addEventListener("click", () => switchTab("converter"));
        tabMatrixBtn?.addEventListener("click", () => switchTab("matrix"));

        if (scrubberSlider) {
          scrubberSlider.addEventListener("input", (e) => {
            setScrubbedHour(Number.parseInt(e.target.value, 10));
          });
        }

        if (formatToggleBtn) {
          formatToggleBtn.addEventListener("click", () => {
            is24Hour = !is24Hour;
            saveState();
            formatToggleBtn.textContent = is24Hour ? "⏱️ Mode: 24H" : "⏱️ Mode: 12H";
            renderAll();
          });
        }

        if (resetCitiesBtn) {
          resetCitiesBtn.addEventListener("click", () => {
            pinnedCityIds = [...defaultCityIds];
            baseCityId = "london";
            saveState();
            renderAll();
          });
        }

        if (resetTimeBtn) {
          resetTimeBtn.addEventListener("click", () => {
            isLive = true;
            resetTimeBtn.style.outline = "none";
            scrubbedUtcHour = new Date().getUTCHours();
            if (scrubberSlider) scrubberSlider.value = scrubbedUtcHour;
            renderAll();
          });
        }

        if (jumpGoldenBtn) {
          jumpGoldenBtn.addEventListener("click", () => {
            const bestH = findBestOverlapHour();
            setScrubbedHour(bestH);
          });
        }

        function addCity(id) {
          if (!id) return;
          if (!pinnedCityIds.includes(id)) {
            pinnedCityIds.push(id);
            saveState();
            renderAll();
          }
          // Highlight card
          setTimeout(() => {
            const card = document.getElementById(`clock-card-${id}`);
            if (card) {
              card.scrollIntoView({ behavior: "smooth", block: "center" });
              card.classList.add("highlight-pulse");
              setTimeout(() => card.classList.remove("highlight-pulse"), 1500);
            }
          }, 100);
        }

        if (addCityBtn && citySelector) {
          addCityBtn.addEventListener("click", () => {
            addCity(citySelector.value);
            citySelector.value = "";
          });
        }

        document.querySelectorAll(".quick-add-pill").forEach((pill) => {
          pill.addEventListener("click", (e) => {
            const id = e.currentTarget.getAttribute("data-id");
            addCity(id);
          });
        });

        // Converter Inputs listeners
        [convDateInput, convTimeInput, convFromCity, convToCity].forEach((el) => {
          el?.addEventListener("change", renderConverter);
          el?.addEventListener("input", renderConverter);
        });

        // Preset Time buttons
        document.querySelectorAll(".conv-preset-btn").forEach((btn) => {
          btn.addEventListener("click", (e) => {
            const presetTime = e.currentTarget.getAttribute("data-time");
            if (presetTime === "now") {
              const now = new Date();
              const h = now.getHours().toString().padStart(2, "0");
              const m = now.getMinutes().toString().padStart(2, "0");
              if (convTimeInput) convTimeInput.value = `${h}:${m}`;
            } else if (convTimeInput) {
              convTimeInput.value = presetTime;
            }
            renderConverter();
          });
        });

        // Swap button
        if (convSwapBtn && convFromCity && convToCity) {
          convSwapBtn.addEventListener("click", () => {
            const fromVal = convFromCity.value;
            const toVal = convToCity.value;
            if (toVal !== "ALL") {
              convFromCity.value = toVal;
              convToCity.value = fromVal;
              renderConverter();
            }
          });
        }

        if (convCopyBtn) {
          convCopyBtn.addEventListener("click", () => {
            const originCity = citiesMap.get(convFromCity.value) || WORLD_CITIES[0];
            const timeVal = convTimeInput.value;
            const dateVal = convDateInput.value;
            let summaryText = `Timezone Conversion from ${originCity.flag} ${originCity.name} at ${timeVal} on ${dateVal}:\n\n`;

            const [y, mo, d] = dateVal.split("-").map((v) => Number.parseInt(v, 10));
            const [hStr, mStr] = timeVal.split(":");
            const fakeUtc = new Date(Date.UTC(y, mo - 1, d, Number.parseInt(hStr, 10), Number.parseInt(mStr, 10), 0));
            const probeInfo = getCityTimeInfo(fakeUtc, originCity.timezone);
            const originUtcEpoch = fakeUtc.getTime() - probeInfo.utcOffsetMinutes * 60000;
            const originDate = new Date(originUtcEpoch);

            pinnedCityIds.forEach((id) => {
              const c = citiesMap.get(id);
              if (!c) return;
              const info = getCityTimeInfo(originDate, c.timezone);
              summaryText += `• ${c.flag} ${c.name}: ${info.formattedTime12} (${info.formattedDate})\n`;
            });

            navigator.clipboard.writeText(summaryText).then(() => {
              const prev = convCopyBtn.textContent;
              convCopyBtn.textContent = "✅ Copied to Clipboard!";
              setTimeout(() => {
                convCopyBtn.textContent = prev;
              }, 2000);
            });
          });
        }

        if (convShareBtn) {
          convShareBtn.addEventListener("click", () => {
            const url = new URL(window.location.href);
            url.searchParams.set("from", convFromCity.value);
            url.searchParams.set("to", convToCity.value);
            url.searchParams.set("time", convTimeInput.value);
            url.searchParams.set("date", convDateInput.value);
            url.searchParams.set("tab", "converter");
            navigator.clipboard.writeText(url.href).then(() => {
              const prev = convShareBtn.textContent;
              convShareBtn.textContent = "✅ Link Copied!";
              setTimeout(() => {
                convShareBtn.textContent = prev;
              }, 2000);
            });
          });
        }

        // Initialize URL parameters and hash navigation
        const urlParams = new URLSearchParams(window.location.search);
        const hash = window.location.hash.replace("#", "");

        if (hash === "converter" || urlParams.get("tab") === "converter") {
          switchTab("converter");
        } else if (hash === "matrix" || urlParams.get("tab") === "matrix") {
          switchTab("matrix");
        } else if (hash === "clocks" || urlParams.get("tab") === "clocks") {
          switchTab("clocks");
        }

        window.addEventListener("hashchange", () => {
          const h = window.location.hash.replace("#", "");
          if (h === "converter" || h === "matrix" || h === "clocks") {
            switchTab(h);
          }
        });

        if (urlParams.has("from") && convFromCity) {
          convFromCity.value = urlParams.get("from");
        }
        if (urlParams.has("to") && convToCity) {
          convToCity.value = urlParams.get("to");
        }
        if (urlParams.has("time") && convTimeInput) {
          convTimeInput.value = urlParams.get("time");
        }

        // Real-time 1-second in-place tick (DOES NOT destroy DOM)
        setInterval(() => {
          if (isLive) {
            updateClockTimesInPlace();
          }
        }, 1000);

        // Initial render
        renderAll();
      })();
    </script>
  </body>
</html>
