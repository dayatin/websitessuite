---
import { getAntiFOUCScript, renderHeaderHTML, renderFooterHTML } from "@suite/ui-theme";
import { renderMetaTags, buildFAQSchema, buildBreadcrumbSchema, buildWebApplicationSchema } from "@suite/seo-core";
import { renderAdSlotHTML, renderAffiliateCardHTML, renderConsentBannerHTML, getConsentModeScript } from "@suite/monetization";
import { FOCUS_MODES } from "../lib/arcade-engine.ts";

const siteTitle = "FocusFlow & BrainArcade | Ambient Soundscapes, Pomodoro & Cognitive Focus Puzzles";
const canonicalUrl = Astro.site ? Astro.site.href : "https://focus-arcade.suite.local/";
const description = "Synthesize procedural Brown, Pink, and White noise, run customizable Pomodoro focus cycles, and sharpen working memory with cognitive micro-breaks. 100% free with zero CLS.";

const metaHtml = renderMetaTags({
  title: siteTitle,
  description,
  canonicalUrl,
  siteName: "FocusFlow & BrainArcade",
  type: "website",
});

const appSchema = buildWebApplicationSchema({
  name: "FocusFlow & BrainArcade",
  url: canonicalUrl,
  description,
  applicationCategory: "HealthApplication",
});

const faqs = [
  {
    question: "How are the ambient noise soundscapes generated?",
    answer: "Our audio engine uses mathematical algorithms (Paul Kellet's 1/f filter for Pink noise and integrated random walk for Brown noise) to synthesize continuous soundscapes directly via the Web Audio API. There are zero looped MP3 files, zero buffering, and zero bandwidth consumption.",
  },
  {
    question: "What are Binaural Beats and how do they aid concentration?",
    answer: "Binaural beats occur when slightly different frequencies are played independently into each ear through headphones. The brain perceives the frequency difference (e.g., 10 Hz Alpha waves), encouraging synchronized neural oscillations associated with relaxed alertness and deep work.",
  },
  {
    question: "Why include cognitive micro-break puzzles?",
    answer: "Brief 60-second cognitive tasks (such as mental math sprints or Stroop challenges) engage the prefrontal cortex during scheduled Pomodoro rest intervals, preventing passive social media doomscrolling and accelerating mental recovery.",
  },
];

const faqSchema = buildFAQSchema(faqs);
const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Home", url: canonicalUrl },
]);

const adSlotTop = renderAdSlotHTML({
  client: "ca-pub-0000000000000000",
  slotId: "15001001001",
  format: "leaderboard",
  testMode: true,
});

const adSlotBottom = renderAdSlotHTML({
  client: "ca-pub-0000000000000000",
  slotId: "15001001002",
  format: "rectangle",
  testMode: true,
});

const affiliateOffer = renderAffiliateCardHTML({
  title: "Sony WH-1000XM5 Active Noise Cancelling Headphones",
  description: "Industry-leading dual processor active noise cancellation engineered for uninterrupted deep work and acoustic isolation.",
  ctaText: "Explore Headphone Gear",
  affiliateUrl: "https://partner.suite.local/sony-audio",
  merchantName: "Consumer Tech Partner Network",
  badge: "Hardware Standard",
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Fragment set:html={metaHtml} />
    <Fragment set:html={getAntiFOUCScript()} />
    <Fragment set:html={getConsentModeScript()} />
    <Fragment set:html={appSchema} />
    <Fragment set:html={faqSchema} />
    <Fragment set:html={breadcrumbSchema} />
    <style>
      .hero-section {
        text-align: center;
        padding: 3rem 1rem 2rem;
        max-width: 900px;
        margin: 0 auto;
      }
      .focus-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(139, 92, 246, 0.1);
        color: #7c3aed;
        font-weight: 700;
        font-size: 0.85rem;
        padding: 0.35rem 0.85rem;
        border-radius: 9999px;
        margin-bottom: 1rem;
        border: 1px solid rgba(139, 92, 246, 0.25);
      }
      .hero-title {
        font-size: 2.75rem;
        font-weight: 900;
        letter-spacing: -0.03em;
        line-height: 1.15;
        margin-bottom: 1rem;
      }
      .hero-subtitle {
        font-size: 1.2rem;
        color: #64748b;
        max-width: 720px;
        margin: 0 auto 2rem;
        line-height: 1.6;
      }
      .focus-dashboard {
        background: #0f172a;
        color: #f8fafc;
        border-radius: 1rem;
        padding: 2.5rem 2rem;
        max-width: 800px;
        margin: 1.5rem auto 2.5rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        text-align: center;
      }
      .timer-display {
        font-size: 3.5rem;
        font-weight: 900;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        letter-spacing: -0.02em;
        color: #a78bfa;
        margin: 1rem 0;
      }
      .modes-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
        max-width: 1000px;
        margin: 2.5rem auto;
      }
      .mode-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 0.85rem;
        padding: 1.75rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        text-align: left;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }
      .mode-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.06);
      }
      .mode-badge {
        align-self: flex-start;
        font-size: 0.72rem;
        font-weight: 800;
        text-transform: uppercase;
        background: #f1f5f9;
        color: #475569;
        padding: 0.2rem 0.5rem;
        border-radius: 0.35rem;
        margin-bottom: 0.75rem;
      }
      .mode-icon {
        font-size: 2.25rem;
        margin-bottom: 0.75rem;
      }
      .mode-title {
        font-size: 1.25rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
        color: #0f172a;
      }
      .mode-desc {
        font-size: 0.92rem;
        color: #64748b;
        line-height: 1.5;
        margin-bottom: 1.25rem;
      }
      .mode-btn {
        display: inline-block;
        text-align: center;
        background: #0f172a;
        color: #ffffff;
        font-weight: 700;
        font-size: 0.9rem;
        padding: 0.7rem 1.2rem;
        border-radius: 0.5rem;
        text-decoration: none;
        transition: background 0.15s ease;
      }
      .mode-btn:hover {
        background: #7c3aed;
      }
    </style>
  </head>
  <body>
    <Fragment set:html={renderHeaderHTML({ currentPath: "/" })} />

    <main class="container">
      <section class="hero-section">
        <div class="focus-pill">
          <span>🧠</span> Synthesized In Web Audio — Zero MP3 Looping
        </div>
        <h1 class="hero-title">Acoustic Soundscapes & Focus Arcade</h1>
        <p class="hero-subtitle">
          Shield your attention with procedural Brown Noise, boost deep work flow with Pomodoro interval timing, and sharpen cognition with evidence-backed focus micro-games.
        </p>

        <!-- Zero-CLS Monetization Slot -->
        <div style="margin: 1.5rem 0 2rem;">
          <Fragment set:html={adSlotTop} />
        </div>

        <div class="focus-dashboard">
          <div style="font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.08em; color: #94a3b8; font-weight: 700;">
            Ultradian Deep Work Timer
          </div>
          <div class="timer-display">25:00</div>
          <div style="display: flex; gap: 0.75rem; justify-content: center; margin-top: 1rem;">
            <button type="button" style="background: #7c3aed; color: #ffffff; border: none; padding: 0.65rem 1.5rem; border-radius: 0.5rem; font-weight: 700; cursor: pointer;" onclick="alert('Pomodoro focus cycle started!')">
              ▶ Start Focus Session
            </button>
            <a href="/play/deep-focus" style="background: rgba(255, 255, 255, 0.1); color: #ffffff; padding: 0.65rem 1.2rem; border-radius: 0.5rem; text-decoration: none; font-weight: 700;">
              🎧 Soundscapes
            </a>
          </div>
        </div>
      </section>

      <!-- Focus Modules Grid -->
      <section id="modes">
        <h2 style="text-align: center; font-size: 1.75rem; font-weight: 800; margin-bottom: 0.5rem;">Soundscape & Cognitive Modules</h2>
        <p style="text-align: center; color: #64748b; margin-bottom: 2rem;">Scientifically designed audio synthesis and cognitive activation suites</p>

        <div class="modes-grid">
          {FOCUS_MODES.map((mode) => (
            <article class="mode-card">
              <div>
                <span class="mode-badge">{mode.badge}</span>
                <div class="mode-icon">{mode.icon}</div>
                <h3 class="mode-title">{mode.title}</h3>
                <p class="mode-desc">{mode.description}</p>
              </div>
              <a href={`/play/${mode.slug}`} class="mode-btn">
                Launch {mode.title} →
              </a>
            </article>
          ))}
        </div>
      </section>

      <!-- Affiliate Partner Section -->
      <section style="max-width: 800px; margin: 3rem auto;">
        <Fragment set:html={affiliateOffer} />
      </section>

      <!-- FAQs -->
      <section style="max-width: 800px; margin: 2.5rem auto; text-align: left;">
        <h2 style="text-align: center; font-size: 1.75rem; font-weight: 800; margin-bottom: 1.5rem;">Frequently Asked Questions</h2>
        {faqs.map((faq) => (
          <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 0.75rem; padding: 1.25rem 1.5rem; margin-bottom: 1rem;">
            <h3 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 0.5rem; color: #0f172a;">{faq.question}</h3>
            <p style="font-size: 0.92rem; color: #475569; margin: 0; line-height: 1.5;">{faq.answer}</p>
          </div>
        ))}
      </section>

      <!-- Zero-CLS Monetization Slot -->
      <div style="margin: 2.5rem 0;">
        <Fragment set:html={adSlotBottom} />
      </div>
    </main>

    <Fragment set:html={renderFooterHTML()} />
    <Fragment set:html={renderConsentBannerHTML()} />
  </body>
</html>
