---
import "@suite/ui-theme/base.css";
import { getAntiFOUCScript, renderHeaderHTML, renderFooterHTML } from "@suite/ui-theme";
import { renderMetaTags, buildFAQSchema, buildBreadcrumbSchema, buildWebApplicationSchema } from "@suite/seo-core";
import { renderAdSlotHTML, renderAffiliateCardHTML, renderConsentBannerHTML, getConsentModeScript } from "@suite/monetization";
import { DOC_TEMPLATES } from "../lib/doc-engine.ts";

const siteTitle = "DocMint Studio | Free Invoices, ATS Resumes & Business Documents";
const canonicalUrl = Astro.site ? Astro.site.href : "https://doc-mint.suite.local/";
const description = "Mint professional commercial invoices, ATS-compliant tech resumes, receipts, and purchase orders directly in your browser. 100% private, client-side, zero cloud telemetry.";

const metaHtml = renderMetaTags({
  title: siteTitle,
  description,
  canonicalUrl,
  siteName: "DocMint Studio",
  type: "website",
});

const appSchema = buildWebApplicationSchema({
  name: "DocMint Studio",
  url: canonicalUrl,
  description,
  applicationCategory: "BusinessApplication",
});

const faqs = [
  {
    question: "Do my sensitive financial numbers, client details, or resume get saved on a server?",
    answer: "No. Never. DocMint Studio operates 100% locally inside your web browser. All invoice totals, client names, and resume text remain strictly within your device memory.",
  },
  {
    question: "Are the resumes generated by DocMint compatible with corporate ATS systems?",
    answer: "Yes, our resume templates use standardized single-column typography, clean semantic headings, and standard date formatting specifically engineered for flawless parsing through Workday, Greenhouse, and Lever.",
  },
  {
    question: "Can I download my documents directly as PDFs?",
    answer: "Yes, all document views are configured with print-optimized CSS matching standard ISO A4 and US Letter page boundaries, allowing instant 1-click PDF export via your browser's native print engine.",
  },
];

const faqSchema = buildFAQSchema(faqs);
const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Home", url: canonicalUrl },
]);

const adSlotTop = renderAdSlotHTML({
  client: "ca-pub-0000000000000000",
  slotId: "11001001001",
  format: "leaderboard",
  testMode: true,
});

const adSlotBottom = renderAdSlotHTML({
  client: "ca-pub-0000000000000000",
  slotId: "11001001002",
  format: "rectangle",
  testMode: true,
});

const affiliateOffer = renderAffiliateCardHTML({
  title: "FreshBooks Cloud Accounting & Tax Software",
  description: "Automate recurring client invoicing, expense receipt scanning, and year-end double-entry tax filing.",
  ctaText: "Try FreshBooks Free",
  affiliateUrl: "https://partner.suite.local/freshbooks",
  merchantName: "FreshBooks Partner Network",
  badge: "Accounting Standard",
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Fragment set:html={metaHtml} />
    <script is:inline set:html={getAntiFOUCScript()} />
    <Fragment set:html={getConsentModeScript()} />
    <script type="application/ld+json" is:inline set:html={appSchema} />
    <script type="application/ld+json" is:inline set:html={faqSchema} />
    <script type="application/ld+json" is:inline set:html={breadcrumbSchema} />
    <style>
      .hero-section {
        text-align: center;
        padding: 3rem 1rem 2rem;
        max-width: 900px;
        margin: 0 auto;
      }
      .privacy-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(13, 148, 136, 0.1);
        color: #0f766e;
        font-weight: 700;
        font-size: 0.85rem;
        padding: 0.35rem 0.85rem;
        border-radius: 9999px;
        margin-bottom: 1rem;
        border: 1px solid rgba(13, 148, 136, 0.25);
      }
      .hero-title {
        font-size: 2.75rem;
        font-weight: 900;
        letter-spacing: -0.03em;
        line-height: 1.15;
        margin-bottom: 1rem;
      }
      .hero-subtitle {
        font-size: 1.2rem;
        color: #64748b;
        max-width: 720px;
        margin: 0 auto 2rem;
        line-height: 1.6;
      }
      .templates-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
        max-width: 1000px;
        margin: 2.5rem auto;
      }
      .template-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 0.85rem;
        padding: 1.75rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        text-align: left;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }
      .template-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.06);
      }
      .template-badge {
        align-self: flex-start;
        font-size: 0.72rem;
        font-weight: 800;
        text-transform: uppercase;
        background: #f1f5f9;
        color: #475569;
        padding: 0.2rem 0.5rem;
        border-radius: 0.35rem;
        margin-bottom: 0.75rem;
      }
      .template-icon {
        font-size: 2.25rem;
        margin-bottom: 0.75rem;
      }
      .template-title {
        font-size: 1.25rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
        color: #0f172a;
      }
      .template-desc {
        font-size: 0.92rem;
        color: #64748b;
        line-height: 1.5;
        margin-bottom: 1.25rem;
      }
      .mint-btn {
        display: inline-block;
        text-align: center;
        background: #0f766e;
        color: #ffffff;
        font-weight: 700;
        font-size: 0.9rem;
        padding: 0.7rem 1.2rem;
        border-radius: 0.5rem;
        text-decoration: none;
        transition: background 0.15s ease;
      }
      .mint-btn:hover {
        background: #115e59;
      }
    </style>
  </head>
  <body>
    <Fragment set:html={renderHeaderHTML({ siteTitle: "DocMint", navItems: [{ label: "Templates", href: "/#templates" }, { label: "Freelance Invoice", href: "/templates/freelance-invoice" }, { label: "Software Resume", href: "/templates/software-engineer-resume" }, { label: "Sales Receipt", href: "/templates/sales-receipt" }, { label: "About", href: "/about" }] })} />

    <main class="container">
      <section class="hero-section">
        <div class="privacy-badge">
          <span>💼</span> 100% Private In-Browser Document Minting
        </div>
        <h1 class="hero-title">Professional Business & Career Studio</h1>
        <p class="hero-subtitle">
          Mint client invoices, calculate multi-tier sales tax, generate ATS-compliant tech resumes, and produce commercial purchase orders with zero cloud telemetry.
        </p>

        <!-- Zero-CLS Monetization Slot -->
        <div style="margin: 1.5rem 0 2rem;">
          <Fragment set:html={adSlotTop} />
        </div>
      </section>

      <!-- Document Templates Catalog -->
      <section id="templates">
        <h2 style="text-align: center; font-size: 1.75rem; font-weight: 800; margin-bottom: 0.5rem;">Document Templates Suite</h2>
        <p style="text-align: center; color: #64748b; margin-bottom: 2rem;">Clean formatting, zero subscription paywalls, and print-ready A4 exports</p>

        <div class="templates-grid">
          {DOC_TEMPLATES.map((tmpl) => (
            <article class="template-card">
              <div>
                <span class="template-badge">{tmpl.badge}</span>
                <div class="template-icon">{tmpl.icon}</div>
                <h3 class="template-title">{tmpl.title}</h3>
                <p class="template-desc">{tmpl.description}</p>
              </div>
              <a href={`/templates/${tmpl.slug}`} class="mint-btn">
                Open {tmpl.title} →
              </a>
            </article>
          ))}
        </div>
      </section>

      <!-- Affiliate Partner Section -->
      <section style="max-width: 800px; margin: 3rem auto;">
        <Fragment set:html={affiliateOffer} />
      </section>

      <!-- FAQs -->
      <section style="max-width: 800px; margin: 2.5rem auto; text-align: left;">
        <h2 style="text-align: center; font-size: 1.75rem; font-weight: 800; margin-bottom: 1.5rem;">Frequently Asked Questions</h2>
        {faqs.map((faq) => (
          <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 0.75rem; padding: 1.25rem 1.5rem; margin-bottom: 1rem;">
            <h3 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 0.5rem; color: #0f172a;">{faq.question}</h3>
            <p style="font-size: 0.92rem; color: #475569; margin: 0; line-height: 1.5;">{faq.answer}</p>
          </div>
        ))}
      </section>

      <!-- Zero-CLS Monetization Slot -->
      <div style="margin: 2.5rem 0;">
        <Fragment set:html={adSlotBottom} />
      </div>
    </main>

    <Fragment set:html={renderFooterHTML({ siteTitle: "DocMint", tagline: "Professional PDF document generators with instant client-side rendering." })} />
    <Fragment set:html={renderConsentBannerHTML()} />
  </body>
</html>
