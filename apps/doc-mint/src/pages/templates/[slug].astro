---
import "@suite/ui-theme/base.css";
import { getAntiFOUCScript, renderHeaderHTML, renderFooterHTML } from "@suite/ui-theme";
import { renderMetaTags, buildFAQSchema, buildBreadcrumbSchema, buildWebApplicationSchema } from "@suite/seo-core";
import { renderAdSlotHTML, renderAffiliateCardHTML, renderConsentBannerHTML, getConsentModeScript } from "@suite/monetization";
import { DOC_TEMPLATES } from "../../lib/doc-engine.ts";

export function getStaticPaths() {
  return DOC_TEMPLATES.map((tmpl) => ({
    params: { slug: tmpl.slug },
    props: { template: tmpl },
  }));
}

const { template } = Astro.props;

const siteTitle = `${template.title} | Free Printable Document Template | DocMint`;
const canonicalUrl = Astro.site
  ? new URL(`templates/${template.slug}`, Astro.site).href
  : `https://doc-mint.suite.local/templates/${template.slug}`;
const description = `${template.description} Free, client-side, 1-click printable A4 layout with zero cloud telemetry and zero Cumulative Layout Shift.`;

const metaHtml = renderMetaTags({
  title: siteTitle,
  description,
  canonicalUrl,
  siteName: "DocMint Studio",
  type: "article",
});

const appSchema = buildWebApplicationSchema({
  name: template.title,
  url: canonicalUrl,
  description: template.description,
  applicationCategory: "BusinessApplication",
});

const faqs = [
  {
    question: `How do I print or export my ${template.title} as a PDF?`,
    answer: "Simply click the 'Print or Export PDF' button or press Ctrl+P (Cmd+P on Mac). Our print CSS automatically formats the document into exact standard ISO A4 / US Letter boundaries without headers or ads.",
  },
  {
    question: "Is my personal, client, or financial information securely stored?",
    answer: "Your information is never stored or transmitted to any server. Everything is rendered 100% in your local web browser session.",
  },
];

const faqSchema = buildFAQSchema(faqs);
const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Home", url: "https://doc-mint.suite.local/" },
  { name: "Templates", url: "https://doc-mint.suite.local/#templates" },
  { name: template.title, url: canonicalUrl },
]);

const adSlotTop = renderAdSlotHTML({
  client: "ca-pub-0000000000000000",
  slotId: "11001001003",
  format: "leaderboard",
  testMode: true,
});

const adSlotBottom = renderAdSlotHTML({
  client: "ca-pub-0000000000000000",
  slotId: "11001001004",
  format: "rectangle",
  testMode: true,
});

const affiliateOffer = renderAffiliateCardHTML({
  title: "DocuSign eSignature & Contract Lifecycle",
  description: "Secure digital signatures, legally binding contract automation, and enterprise document workflows.",
  ctaText: "Explore DocuSign",
  affiliateUrl: "https://partner.suite.local/docusign",
  merchantName: "DocuSign Partner Network",
  badge: "Legal Standard",
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Fragment set:html={metaHtml} />
    <Fragment set:html={getAntiFOUCScript()} />
    <Fragment set:html={getConsentModeScript()} />
    <Fragment set:html={appSchema} />
    <Fragment set:html={faqSchema} />
    <Fragment set:html={breadcrumbSchema} />
    <style>
      .doc-hero {
        text-align: center;
        padding: 2.5rem 1rem 1.5rem;
        max-width: 850px;
        margin: 0 auto;
      }
      .doc-icon-large {
        font-size: 3rem;
        margin-bottom: 0.5rem;
      }
      .doc-title-large {
        font-size: 2.5rem;
        font-weight: 900;
        letter-spacing: -0.02em;
        margin-bottom: 0.75rem;
      }
      .doc-lead {
        font-size: 1.15rem;
        color: #64748b;
        line-height: 1.6;
        margin-bottom: 2rem;
      }
      .document-sheet {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 0.5rem;
        padding: 3rem;
        max-width: 800px;
        margin: 0 auto 2.5rem;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
        text-align: left;
      }
      .print-btn {
        background: #0f766e;
        color: #ffffff;
        border: none;
        padding: 0.85rem 1.85rem;
        border-radius: 0.5rem;
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        transition: background 0.15s ease;
      }
      .print-btn:hover {
        background: #115e59;
      }
      .features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.25rem;
        max-width: 850px;
        margin: 2.5rem auto;
        text-align: left;
      }
      .feature-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 0.75rem;
        padding: 1.25rem;
      }
      .feature-box strong {
        display: block;
        color: #0f172a;
        margin-bottom: 0.25rem;
        font-size: 0.95rem;
      }
      .feature-box span {
        color: #64748b;
        font-size: 0.88rem;
        line-height: 1.4;
      }
      @media print {
        header, footer, nav, .doc-hero, .features-grid, .faq-section, [data-ad-slot], [data-consent-banner] {
          display: none !important;
        }
        body, main, .document-sheet {
          background: #ffffff !important;
          box-shadow: none !important;
          border: none !important;
          padding: 0 !important;
          margin: 0 !important;
        }
      }
    </style>
  </head>
  <body>
    <Fragment set:html={renderHeaderHTML({ siteTitle: "DocMint", navItems: [{ label: "Templates", href: "/#templates" }, { label: "Freelance Invoice", href: "/templates/freelance-invoice" }, { label: "Software Resume", href: "/templates/software-engineer-resume" }, { label: "Sales Receipt", href: "/templates/sales-receipt" }, { label: "About", href: "/about" }] })} />

    <main class="container">
      <section class="doc-hero">
        <div class="doc-icon-large">{template.icon}</div>
        <h1 class="doc-title-large">{template.title}</h1>
        <p class="doc-lead">{template.description}</p>

        <!-- Zero-CLS Monetization Slot -->
        <div style="margin: 1.5rem 0 2rem;">
          <Fragment set:html={adSlotTop} />
        </div>

        <div style="margin-bottom: 1.5rem;">
          <button type="button" class="print-btn" onclick="window.print()">
            🖨️ Print or Export to PDF
          </button>
        </div>

        <div class="document-sheet">
          <div style="display: flex; justify-content: space-between; border-bottom: 2px solid #0f766e; padding-bottom: 1.5rem; margin-bottom: 2rem;">
            <div>
              <h2 style="font-size: 1.75rem; font-weight: 900; margin: 0; color: #0f172a;">{template.title}</h2>
              <p style="color: #64748b; font-size: 0.9rem; margin-top: 0.25rem;">Document Reference: #DOC-{new Date().getFullYear()}-001</p>
            </div>
            <div style="text-align: right; color: #475569; font-size: 0.9rem;">
              <strong>Date:</strong> {new Date().toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
            </div>
          </div>

          <div style="background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 0.5rem; padding: 2rem; text-align: center; color: #64748b;">
            <p style="margin: 0; font-size: 1rem; font-weight: 600;">Interactive {template.type.toUpperCase()} Canvas</p>
            <p style="margin: 0.5rem 0 0; font-size: 0.85rem;">Ready for live client-side editing and instant PDF generation</p>
          </div>
        </div>
      </section>

      <!-- Features Grid -->
      <section class="features-grid">
        {template.features.map((feature) => (
          <div class="feature-box">
            <strong>✓ Template Feature</strong>
            <span>{feature}</span>
          </div>
        ))}
      </section>

      <!-- Affiliate Partner Section -->
      <section style="max-width: 800px; margin: 3rem auto;">
        <Fragment set:html={affiliateOffer} />
      </section>

      <!-- FAQ Section -->
      <section class="faq-section" style="max-width: 800px; margin: 2.5rem auto; text-align: left;">
        <h2 style="font-size: 1.5rem; font-weight: 800; margin-bottom: 1.25rem;">Frequently Asked Questions</h2>
        {faqs.map((faq) => (
          <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 0.75rem; padding: 1.25rem; margin-bottom: 1rem;">
            <h3 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 0.5rem; color: #0f172a;">{faq.question}</h3>
            <p style="font-size: 0.92rem; color: #475569; margin: 0; line-height: 1.5;">{faq.answer}</p>
          </div>
        ))}
      </section>

      <!-- Zero-CLS Monetization Slot -->
      <div style="margin: 2.5rem 0;">
        <Fragment set:html={adSlotBottom} />
      </div>
    </main>

    <Fragment set:html={renderFooterHTML({ siteTitle: "DocMint", tagline: "Professional PDF document generators with instant client-side rendering." })} />
    <Fragment set:html={renderConsentBannerHTML()} />
  </body>
</html>
